HloModule two_gemm_gte, entry_computation_layout={(bf16[64,64]{1,0}, bf16[64,64]{1,0}, bf16[64,64]{1,0}, bf16[64,64]{1,0}) -> bf16[64,64]{1,0}}

ENTRY main {
    %a0 = bf16[64,64]{1,0} parameter(0)
    %b0 = bf16[64,64]{1,0} parameter(1)
    %a1 = bf16[64,64]{1,0} parameter(2)
    %b1 = bf16[64,64]{1,0} parameter(3)
    %y0 = bf16[64,64]{1,0} dot(%a0, %b0), lhs_contracting_dims={1}, rhs_contracting_dims={0}
    %y1 = bf16[64,64]{1,0} dot(%a1, %b1), lhs_contracting_dims={1}, rhs_contracting_dims={0}
    %pair = (bf16[64,64]{1,0}, bf16[64,64]{1,0}) tuple(%y0, %y1)
    %first = bf16[64,64]{1,0} get-tuple-element(%pair), index=0
    %second = bf16[64,64]{1,0} get-tuple-element(%pair), index=1
    ROOT %output = bf16[64,64]{1,0} dot(%first, %second), lhs_contracting_dims={1}, rhs_contracting_dims={0}
}
