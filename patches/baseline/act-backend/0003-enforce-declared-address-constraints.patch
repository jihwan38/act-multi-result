index 0000000..8485944
--- /dev/null
+++ b/act_backend/generic/cpp/malloc/include/address_constraints.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <limits>
+#include <stdexcept>
+#include "solver.h"
+
+// OR-Tools MakeModulo constrains the remainder's sign. Shift the numerator
+// by a multiple of the positive modulus to implement Python-style % even for
+// negative affine address differences, without overflowing the int64 domain.
+inline operations_research::IntExpr *address_modulo(
+    operations_research::IntExpr *value, int64 modulus) {
+  if (modulus <= 0) throw std::invalid_argument("Constraint modulus must be positive");
+  __int128 lower = value->Min();
+  __int128 shift = lower < 0 ? ((-lower + modulus - 1) / modulus) * modulus : 0;
+  if (shift > std::numeric_limits<int64>::max()
+      || __int128(value->Max()) + shift > std::numeric_limits<int64>::max())
+    throw std::invalid_argument("Constraint modulo domain exceeds int64");
+  return solver.MakeModulo(solver.MakeSum(value, int64(shift)), modulus);
+}
