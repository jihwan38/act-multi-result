index 0000000..cb96946
--- /dev/null
+++ b/act_backend/address_constraints.py
@@ -0,0 +1,99 @@
+"""Lower declared integer address predicates to the existing OR-Tools solver.
+
+Supported: declared address/computation names, integers, +, -, *, positive
+constant/computation-attribute modulus, comparisons, and/or/not. Unsupported
+syntax fails generation; no predicate is silently dropped or evaluated as code.
+"""
+import ast
+import re
+
+
+class ConstraintLowerer:
+    def __init__(self, instruction):
+        self.addresses = set(instruction.parameters)
+        self.attributes = set(instruction.comp_attr)
+        if self.addresses & self.attributes:
+            raise ValueError("Address and computation attribute names overlap")
+        self.guards = set()
+
+    def parse(self, source):
+        def qualify(match):
+            kind, name = match.groups()
+            allowed = self.addresses if kind == "a" else self.attributes
+            if name not in allowed:
+                raise ValueError(f"Unknown constraint attribute: {match.group()}")
+            return name
+        source = re.sub(r"@([ac])\.(\w+)", qualify, source).strip()
+        return ast.parse(source, mode="eval").body
+
+    def integer(self, node):
+        if isinstance(node, ast.Constant) and type(node.value) is int:
+            if not -(2**63) < node.value < 2**63:
+                raise ValueError("Constraint integer exceeds signed 64-bit range")
+            return f"solver.MakeIntConst(int64_t({node.value}))"
+        if isinstance(node, ast.Name):
+            if node.id in self.addresses:
+                return node.id
+            if node.id in self.attributes:
+                return f"solver.MakeIntConst({node.id})"
+            raise ValueError(f"Unknown constraint variable: {node.id}")
+        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
+            value = self.integer(node.operand)
+            return value if isinstance(node.op, ast.UAdd) else f"solver.MakeOpposite({value})"
+        if isinstance(node, ast.BinOp):
+            left = self.integer(node.left)
+            right = self.integer(node.right)
+            methods = {ast.Add: "MakeSum", ast.Sub: "MakeDifference", ast.Mult: "MakeProd"}
+            if type(node.op) in methods:
+                return f"solver.{methods[type(node.op)]}({left}, {right})"
+            if isinstance(node.op, ast.Mod):
+                divisor = node.right
+                if isinstance(divisor, ast.Constant) and type(divisor.value) is int and divisor.value > 0:
+                    modulus = str(divisor.value)
+                elif isinstance(divisor, ast.Name) and divisor.id in self.attributes:
+                    modulus = divisor.id
+                    self.guards.add(modulus)
+                else:
+                    raise ValueError("Constraint modulus must be a positive integer or computation attribute")
+                return f"address_modulo({left}, {modulus})"
+        raise ValueError(f"Unsupported constraint arithmetic: {ast.dump(node)}")
+
+    def predicate(self, node):
+        if isinstance(node, ast.Constant) and type(node.value) is bool:
+            return f"solver.MakeIntConst({int(node.value)})"
+        if isinstance(node, ast.Compare):
+            methods = {ast.Eq: "MakeIsEqualVar", ast.NotEq: "MakeIsDifferentVar",
+                       ast.Lt: "MakeIsLessVar", ast.LtE: "MakeIsLessOrEqualVar",
+                       ast.Gt: "MakeIsGreaterVar", ast.GtE: "MakeIsGreaterOrEqualVar"}
+            left = node.left
+            terms = []
+            for op, right in zip(node.ops, node.comparators):
+                if type(op) not in methods:
+                    raise ValueError("Unsupported constraint comparison")
+                terms.append(f"solver.{methods[type(op)]}({self.integer(left)}, {self.integer(right)})")
+                left = right
+            return self.combine("MakeMin", terms)
+        if isinstance(node, ast.BoolOp):
+            method = "MakeMin" if isinstance(node.op, ast.And) else "MakeMax"
+            return self.combine(method, [self.predicate(value) for value in node.values])
+        if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
+            return f"solver.MakeDifference(int64_t(1), {self.predicate(node.operand)})"
+        raise ValueError(f"Unsupported constraint predicate: {ast.dump(node)}")
+
+    @staticmethod
+    def combine(method, values):
+        result = values[0]
+        for value in values[1:]:
+            result = f"solver.{method}({result}, {value})"
+        return result
+
+
+def generate_constraints(instruction):
+    lowerer = ConstraintLowerer(instruction)
+    predicates = [lowerer.predicate(lowerer.parse(line)) for line in instruction.constraints]
+    guards = "".join(
+        f'    if ({name} <= 0) throw std::invalid_argument("Constraint modulus must be positive");\n'
+        for name in sorted(lowerer.guards))
+    return guards + "".join(
+        f"    constraints.push_back(solver.MakeEquality({predicate}, int64_t(1)));\n"
+        for predicate in predicates)
