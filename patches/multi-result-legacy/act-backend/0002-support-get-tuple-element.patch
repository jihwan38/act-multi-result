+fn add_tuple_projection(
+    egraph: &mut EGraph<TensorOp, TensorInfo>,
+    tuple: Id,
+    index: usize,
+) -> Id {
+    let elements = tuple_elements(egraph, tuple).expect("GTE operand must be a tuple");
+    let element = *elements.get(index).expect("GTE index out of bounds");
+    assert!(tuple_elements(egraph, element).is_none(), "Nested tuples are not supported");
+    let info = egraph[element].data.clone();
+    let node = egraph.add(TensorOp::OpGetTupleElement(index, [tuple]));
+    egraph.set_analysis_data(node, info);
+    node
+}
