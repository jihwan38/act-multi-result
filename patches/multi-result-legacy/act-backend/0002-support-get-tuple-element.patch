+/// Flat tuple types are derived from their ordered tensor children, not the
+/// legacy tensor-only analysis slot on the aggregate e-class. Rewriting retains
+/// the OpTuple alternative even when a tuple-producing ISA candidate is added.
+pub fn tuple_elements(
+    egraph: &EGraph<TensorOp, TensorInfo>,
+    id: Id,
+) -> Option<Vec<Id>> {
+    egraph[id].nodes.iter().find_map(|en| match en {
+        TensorOp::OpTuple(children) => Some(children.iter().map(|&id| egraph.find(id)).collect()),
+        _ => None,
+    })
+}
