+fn add_tuple(
+    tsymbol: &str,
+    element_types: &[String],
+    operands: &[String],
+    egraph: &mut EGraph<TensorOp, TensorInfo>,
+    table: &mut EggSymbolTable,
+) -> Id {
+    assert_eq!(element_types.len(), operands.len());
+
+    let children: Vec<Id> = operands
+        .iter()
+        .map(|operand| {
+            *table
+                .get(operand)
+                .unwrap_or_else(|| panic!("Undefined tuple operand: {}", operand))
+        })
+        .collect();
+
+    for ((element_type, operand), child) in element_types.iter().zip(operands).zip(&children) {
+        let (ttype, tshape, _ttile) = parse_type_shape(element_type);
+        let expected_dtype: Dtype = ttype.as_str().into();
+        let expected_shape = shape_to_vec(&tshape);
+        let actual = &egraph[*child].data;
+
+        assert_eq!(
+            actual.dtype, expected_dtype,
+            "Tuple element type differs from operand {}",
+            operand
+        );
+        assert_eq!(
+            actual.shape, expected_shape,
+            "Tuple element shape differs from operand {}",
+            operand
+        );
+    }
+
+    let node = egraph.add(TensorOp::OpTuple(children));
+    table.insert(tsymbol.to_string(), node);
+    node
+}
+
+fn bind_root_tuple_outputs(
+    element_types: &[String],
+    operands: &[String],
+    declared_outputs: &[MetaDataInfo],
+    table: &EggSymbolTable,
+    offsets: &mut [(Option<Id>, i32)],
+) {
+    assert_eq!(
+        element_types.len(),
+        operands.len(),
+        "Root tuple element type and operand counts differ"
+    );
+    assert_eq!(
+        declared_outputs.len(),
+        operands.len(),
+        "Root tuple arity differs from module header output count"
+    );
+
+    for (index, (element_type, declared_output)) in
+        element_types.iter().zip(declared_outputs).enumerate()
+    {
+        let (ttype, tshape, _ttile) = parse_type_shape(element_type);
+        let tuple_dtype: Dtype = ttype.as_str().into();
+        let tuple_shape = shape_to_vec(&tshape);
+
+        assert_eq!(
+            declared_output.dtype, tuple_dtype,
+            "Root tuple element {} dtype differs from module header output",
+            index
+        );
+        assert_eq!(
+            declared_output.shape, tuple_shape,
+            "Root tuple element {} shape differs from module header output",
+            index
+        );
+    }
+
+    let output_start = offsets
+        .len()
+        .checked_sub(declared_outputs.len())
+        .expect("Module header outputs exceed the offset table");
+    for (offset, operand) in offsets[output_start..].iter_mut().zip(operands) {
+        let child = *table
+            .get(operand)
+            .unwrap_or_else(|| panic!("Undefined tuple operand: {}", operand));
+        offset.0 = Some(child);
+    }
+}
