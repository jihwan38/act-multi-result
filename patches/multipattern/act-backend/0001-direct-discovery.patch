+    use crate::ir::egraph::{TensorInfo, TensorOp};
+    use egg::{EGraph, Id};
+    use std::collections::HashSet;
+
+    type Graph = EGraph<TensorOp, TensorInfo>;
+
+    fn tensor(graph: &mut Graph, op: TensorOp, shape: &[i32]) -> Id {
+        let id = graph.add(op);
+        graph.set_analysis_data(
+            id,
+            TensorInfo {
+                dtype: Dtype::BF16,
+                shape: shape.to_vec(),
+                is_const: false,
+            },
+        );
+        id
+    }
+
+    fn matrix(graph: &mut Graph, op: TensorOp) -> Id {
+        tensor(graph, op, &[64, 64])
+    }
+
+    #[test]
+    fn repeated_bare_results_are_unique_diagonal_pairs_with_the_root_as_input() {
+        // Returning tuple(x, x) is one assignment per tensor value, even when
+        // that value has several equivalent leaf or operation representations.
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let alias = matrix(&mut graph, TensorOp::Var("alias_of_a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        graph.union(a, alias);
+        let product = matrix(&mut graph, TensorOp::OpDot([a, b]));
+        let alternative = matrix(&mut graph, TensorOp::OpDot([b, a]));
+        // This equality is supplied to the test, not inferred for arbitrary
+        // matrix products. It exposes two enodes for the same returned value.
+        graph.union(product, alternative);
+        graph.rebuild();
+        let roots = HashSet::from([graph.find(a), graph.find(b), graph.find(product)]);
+        assert_eq!(roots.len(), 3);
+        let patterns = [
+            ("?p0", Dtype::BF16, vec![Some(64), Some(64)]),
+            ("?p0__use1", Dtype::BF16, vec![Some(64), Some(64)]),
+        ];
+
+        for limit in [1, 2, 3, 8] {
+            let found = joint_matches(&graph, &patterns, limit);
+            assert_eq!(found.len(), limit.min(roots.len()));
+            let mut unique = HashSet::new();
+            for matched in &found {
+                assert_eq!(matched.len(), 2);
+                let root = graph.find(matched[0].id);
+                assert!(roots.contains(&root));
+                assert_eq!(graph.find(matched[1].id), root);
+                assert!(unique.insert(root), "duplicate assignments consume the cap");
+                for result in matched {
+                    assert_eq!(
+                        result.operands,
+                        vec![root],
+                        "the semantic input is the returned value, not its enode children"
+                    );
+                }
+            }
+            if limit >= roots.len() {
+                assert_eq!(unique, roots);
+            }
+        }
+    }
+
+    #[test]
+    fn nested_repeated_reshape_inputs_remain_equal_with_a_shared_copy_result() {
+        // The ISA returns add(reshape(x), reshape(x)) and copy(x). The two
+        // wildcard reshape occurrences and the copy must bind one input x.
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        let reshape_a = tensor(
+            &mut graph,
+            TensorOp::OpReshape("32,128".into(), [a]),
+            &[32, 128],
+        );
+        let reshape_b = tensor(
+            &mut graph,
+            TensorOp::OpReshape("32,128".into(), [b]),
+            &[32, 128],
+        );
+        let sum_a = tensor(
+            &mut graph,
+            TensorOp::OpAdd([reshape_a, reshape_a]),
+            &[32, 128],
+        );
+        let sum_b = tensor(
+            &mut graph,
+            TensorOp::OpAdd([reshape_b, reshape_b]),
+            &[32, 128],
+        );
+        let mixed = tensor(
+            &mut graph,
+            TensorOp::OpAdd([reshape_a, reshape_b]),
+            &[32, 128],
+        );
+        let copy_a = matrix(&mut graph, TensorOp::OpCopy([a]));
+        let copy_b = matrix(&mut graph, TensorOp::OpCopy([b]));
+        graph.rebuild();
+        let patterns = [
+            (
+                "(add (reshape_? ?p0) (reshape_? ?p0__use1))",
+                Dtype::BF16,
+                vec![Some(32), Some(128)],
+            ),
+            ("(copy ?p0__use2)", Dtype::BF16, vec![Some(64), Some(64)]),
+        ];
+
+        let found = joint_matches(&graph, &patterns, 64);
+        let pairs: HashSet<_> = found
+            .iter()
+            .map(|matched| {
+                assert_eq!(matched.len(), 2);
+                let first = graph.find(matched[0].id);
+                assert_ne!(first, graph.find(mixed));
+                let input = if first == graph.find(sum_a) {
+                    graph.find(a)
+                } else {
+                    assert_eq!(first, graph.find(sum_b));
+                    graph.find(b)
+                };
+                for result in matched {
+                    assert_eq!(result.operands, vec![input]);
+                }
+                [first, graph.find(matched[1].id)]
+            })
+            .collect();
+        assert_eq!(
+            pairs,
+            HashSet::from([
+                [graph.find(sum_a), graph.find(copy_a)],
+                [graph.find(sum_b), graph.find(copy_b)],
+            ])
+        );
+        assert_eq!(found.len(), pairs.len());
+    }
+}
