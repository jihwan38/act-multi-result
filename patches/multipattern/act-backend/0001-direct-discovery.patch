+    #[test]
+    fn bare_identity_results_accept_tensors_without_an_operator_anchor() {
+        // An ISA can return its two input tensors unchanged. A result pattern
+        // containing only a variable must still participate in the joint search.
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        // Tuple structure, rather than the legacy tensor-analysis slot, defines
+        // an aggregate's type. Even matching analysis data cannot make it a
+        // tensor result of this ISA.
+        let aggregate = matrix(&mut graph, TensorOp::OpTuple(vec![a, b]));
+        graph.rebuild();
+        let patterns = [
+            ("?p0", Dtype::BF16, vec![Some(64), Some(64)]),
+            ("?p1", Dtype::BF16, vec![Some(64), Some(64)]),
+        ];
+
+        let found = result_pairs(&graph, &patterns);
+        let [a, b] = [graph.find(a), graph.find(b)];
+        assert_eq!(found, HashSet::from([[a, a], [a, b], [b, a], [b, b]]));
+        assert!(!found
+            .iter()
+            .flatten()
+            .any(|&id| id == graph.find(aggregate)));
+    }
