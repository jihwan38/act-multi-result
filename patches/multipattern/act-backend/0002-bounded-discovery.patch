+#[cfg(test)]
+mod budget_tests {
+    use super::*;
+    use crate::ir::dtype::Dtype;
+    use std::time::Duration;
+
+    type Graph = EGraph<TensorOp, TensorInfo>;
+
+    fn tensor(graph: &mut Graph, node: TensorOp, shape: &[i32]) -> Id {
+        let id = graph.add(node);
+        graph.set_analysis_data(
+            id,
+            TensorInfo {
+                dtype: Dtype::BF16,
+                shape: shape.to_vec(),
+                is_const: false,
+            },
+        );
+        id
+    }
+
+    fn matrix(graph: &mut Graph, node: TensorOp) -> Id {
+        tensor(graph, node, &[64, 64])
+    }
+
+    fn pattern(text: &'static str) -> TypedPattern<'static> {
+        (text, Dtype::BF16, vec![Some(64), Some(64)])
+    }
+
+    fn dots(count: usize) -> Graph {
+        let mut graph = Graph::default();
+        for i in 0..count {
+            let a = matrix(&mut graph, TensorOp::Var(format!("a{i}")));
+            let b = matrix(&mut graph, TensorOp::Var(format!("b{i}")));
+            matrix(&mut graph, TensorOp::OpDot([a, b]));
+        }
+        graph.rebuild();
+        graph
+    }
+
+    fn discover(
+        graph: &Graph,
+        rules: Vec<Vec<TypedPattern<'static>>>,
+        limit: usize,
+        limits: SearchLimits,
+        deadline: Option<Instant>,
+    ) -> Discovery {
+        let mut discovery = Discovery {
+            queries: rules
+                .iter()
+                .map(|patterns| JointQuery::new(patterns))
+                .collect(),
+            pending: VecDeque::new(),
+            seen: HashSet::new(),
+            registered_total: 0,
+            limit,
+            limits,
+            report: SearchBudget::new(limits, deadline).report,
+        };
+        discovery.refresh_until(graph, deadline);
+        discovery
+    }
+
+    fn pair() -> Vec<TypedPattern<'static>> {
+        vec![pattern("(dot ?p0 ?p1)"), pattern("(dot ?p2 ?p3)")]
+    }
+
+    fn selected(discovery: &Discovery) -> Vec<(usize, Vec<Id>)> {
+        discovery
+            .pending
+            .iter()
+            .map(|candidate| {
+                (
+                    candidate.instruction,
+                    candidate.results.iter().map(|item| item.id).collect(),
+                )
+            })
+            .collect()
+    }
+
+    #[test]
+    fn small_tuple_target_stops_preparation_before_eager_4096_matches() {
+        let graph = dots(128);
+        let discovery = discover(&graph, vec![pair()], 1, SearchLimits::default(), None);
+        assert_eq!(discovery.pending.len(), 1);
+        assert_eq!(discovery.report.raw_matches, 1);
+        assert_eq!(discovery.report.attempts, 1);
+        assert_eq!(discovery.report.stop_reason, StopReason::CandidateTarget);
+        assert!(!discovery.report.complete);
+        assert!(discovery.report.pending_work);
+    }
+
+    #[test]
+    fn replayed_prefixes_and_rejected_types_obey_the_raw_budget() {
+        let mut graph = dots(1);
+        for i in 0..96 {
+            let x = matrix(&mut graph, TensorOp::Var(format!("wrong{i}")));
+            matrix(&mut graph, TensorOp::OpCopy([x]));
+        }
+        graph.rebuild();
+        let patterns = vec![
+            pattern("(dot ?p0 ?p1)"),
+            ("(copy ?p2)", Dtype::BF16, vec![Some(32), Some(64)]),
+        ];
+        let limits = SearchLimits {
+            raw_matches: 5,
+            search_calls: 1000,
+            attempts: 1000,
+        };
+        let discovery = discover(&graph, vec![patterns], 1, limits, None);
+        assert!(discovery.pending.is_empty());
+        assert!(discovery.report.raw_matches <= 5);
+        assert!(discovery.report.replayed_matches > 0);
+        assert!(discovery.report.rejected_types > 0);
+        assert_eq!(discovery.report.stop_reason, StopReason::RawMatchLimit);
+        assert!(!discovery.report.complete);
+    }
+
+    #[test]
+    fn unsuccessful_searches_are_limited_and_do_not_starve_another_isa() {
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        matrix(&mut graph, TensorOp::OpDot([a, b]));
+        graph.rebuild();
+        let absent = vec![pattern("(add ?p0 ?p1)"), pattern("(copy ?p2)")];
+        let identity = vec![pattern("?p0"), pattern("?p1")];
+        let limits = SearchLimits {
+            raw_matches: 10,
+            search_calls: 2,
+            attempts: 10,
+        };
+        let discovery = discover(&graph, vec![absent, identity], 1, limits, None);
+        assert_eq!(discovery.pending.len(), 1);
+        assert_eq!(discovery.pending[0].instruction, 1);
+        assert_eq!(discovery.report.search_calls, 2);
+        assert_eq!(discovery.report.raw_matches, 1);
+    }
+
+    #[test]
+    fn call_budget_stops_a_scan_that_produces_no_matches() {
+        let graph = dots(20);
+        let patterns = vec![pattern("(add ?p0 ?p1)"), pattern("(copy ?p2)")];
+        let limits = SearchLimits {
+            raw_matches: 100,
+            search_calls: 3,
+            attempts: 100,
+        };
+        let discovery = discover(&graph, vec![patterns], 1, limits, None);
+        assert_eq!(discovery.report.search_calls, 3);
+        assert_eq!(discovery.report.raw_matches, 0);
+        assert_eq!(discovery.report.stop_reason, StopReason::SearchCallLimit);
+        assert!(discovery.report.pending_work);
+    }
+
+    #[test]
+    fn zero_limits_and_expired_deadlines_do_not_claim_exhaustive_search() {
+        let graph = dots(2);
+        for (limits, deadline, reason) in [
+            (
+                SearchLimits {
+                    raw_matches: 0,
+                    ..SearchLimits::default()
+                },
+                None,
+                StopReason::RawMatchLimit,
+            ),
+            (
+                SearchLimits {
+                    search_calls: 0,
+                    ..SearchLimits::default()
+                },
+                None,
+                StopReason::SearchCallLimit,
+            ),
+            (
+                SearchLimits {
+                    attempts: 0,
+                    ..SearchLimits::default()
+                },
+                None,
+                StopReason::AttemptLimit,
+            ),
+            (
+                SearchLimits::default(),
+                Some(Instant::now()),
+                StopReason::Deadline,
+            ),
+        ] {
+            let discovery = discover(&graph, vec![pair()], 1, limits, deadline);
+            assert!(discovery.pending.is_empty());
+            assert_eq!(discovery.report.stop_reason, reason);
+            assert!(!discovery.report.complete);
+            assert_eq!(discovery.report.attempts, 0);
+            if reason != StopReason::AttemptLimit {
+                assert_eq!(discovery.report.search_calls, 0);
+            }
+        }
+        let disabled = discover(&graph, vec![pair()], 0, SearchLimits::default(), None);
+        assert_eq!(disabled.report.stop_reason, StopReason::TupleLimit);
+        assert!(!disabled.report.complete);
+        let empty = discover(&graph, vec![], 64, SearchLimits::default(), None);
+        assert!(empty.report.complete);
+        assert!(!empty.report.pending_work);
+        assert_eq!(empty.report.stop_reason, StopReason::Exhausted);
+    }
+
+    #[test]
+    fn same_snapshot_and_limits_select_the_same_candidate_order() {
+        let graph = dots(30);
+        let reference = discover(&graph, vec![pair()], 17, SearchLimits::default(), None);
+        for _ in 0..5 {
+            let discovery = discover(&graph, vec![pair()], 17, SearchLimits::default(), None);
+            assert_eq!(selected(&discovery), selected(&reference));
+            assert_eq!(discovery.report.raw_matches, reference.report.raw_matches);
+            assert_eq!(discovery.report.search_calls, reference.report.search_calls);
+        }
+    }
+
+    #[test]
+    fn multiple_isas_receive_turns_in_declaration_order() {
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        let dot = matrix(&mut graph, TensorOp::OpDot([a, b]));
+        matrix(&mut graph, TensorOp::OpCopy([dot]));
+        graph.rebuild();
+        let rules = vec![
+            vec![pattern("?p0"), pattern("?p1")],
+            vec![pattern("?p0"), pattern("?p1"), pattern("?p2")],
+        ];
+        let discovery = discover(&graph, rules, 4, SearchLimits::default(), None);
+        assert_eq!(
+            selected(&discovery)
+                .iter()
+                .map(|(rule, _)| *rule)
+                .collect::<Vec<_>>(),
+            vec![0, 1, 0, 1]
+        );
+    }
+
+    #[test]
+    fn three_outputs_preserve_shared_inputs_and_port_order() {
+        let mut graph = Graph::default();
+        let x = matrix(&mut graph, TensorOp::Var("x".into()));
+        let y = matrix(&mut graph, TensorOp::Var("y".into()));
+        let square = matrix(&mut graph, TensorOp::OpMultiply([x, x]));
+        let copy_x = matrix(&mut graph, TensorOp::OpCopy([x]));
+        let copy_y = matrix(&mut graph, TensorOp::OpCopy([y]));
+        graph.rebuild();
+        let rules = vec![vec![
+            pattern("(multiply ?p0 ?p0__use1)"),
+            pattern("(copy ?p0__use2)"),
+            pattern("?p0__use3"),
+        ]];
+        let mut discovery = discover(&graph, rules, 64, SearchLimits::default(), None);
+        assert_eq!(
+            selected(&discovery),
+            vec![(
+                0,
+                vec![graph.find(square), graph.find(copy_x), graph.find(x)]
+            )]
+        );
+        assert!(discovery.report.complete);
+        assert_eq!(
+            discovery.batch(&mut graph, 64, Instant::now() + Duration::from_secs(2)),
+            1
+        );
+        let tuple = graph
+            .lookup(TensorOp::OpTuple(vec![
+                graph.find(square),
+                graph.find(copy_x),
+                graph.find(x),
+            ]))
+            .unwrap();
+        for (port, value) in [square, copy_x, x].into_iter().enumerate() {
+            let projection = graph
+                .lookup(TensorOp::OpGetTupleElement(port, [tuple]))
+                .unwrap();
+            assert_eq!(graph.find(projection), graph.find(value));
+        }
+        assert!(graph
+            .lookup(TensorOp::OpTuple(vec![
+                graph.find(square),
+                graph.find(copy_y),
+                graph.find(x)
+            ]))
+            .is_none());
+    }
+
+    #[test]
+    fn alternative_bindings_of_one_result_tuple_do_not_fill_the_target() {
+        let mut graph = dots(3);
+        let dots: Vec<_> = graph
+            .classes()
+            .filter(|class| {
+                class
+                    .nodes
+                    .iter()
+                    .any(|node| matches!(node, TensorOp::OpDot(_)))
+            })
+            .map(|class| class.id)
+            .collect();
+        for &other in &dots[1..] {
+            graph.union(dots[0], other);
+        }
+        graph.rebuild();
+        let discovery = discover(&graph, vec![pair()], 2, SearchLimits::default(), None);
+        assert_eq!(discovery.pending.len(), 1);
+        assert!(discovery.report.duplicates > 0);
+        assert_eq!(discovery.report.accepted, 1);
+        assert!(discovery.report.complete);
+    }
+
+    #[test]
+    fn eclass_unions_do_not_replenish_the_lifetime_registration_budget() {
+        let mut graph = dots(2);
+        let mut discovery = discover(&graph, vec![pair()], 2, SearchLimits::default(), None);
+        let selected_ids: Vec<_> = discovery
+            .pending
+            .iter()
+            .flat_map(|candidate| candidate.results.iter().map(|result| result.id))
+            .collect();
+        assert_eq!(
+            discovery.batch(&mut graph, 64, Instant::now() + Duration::from_secs(2)),
+            2
+        );
+        for &id in &selected_ids[1..] {
+            graph.union(selected_ids[0], id);
+        }
+        graph.rebuild();
+        discovery.refresh(&graph);
+        assert_eq!(discovery.seen.len(), 1);
+        assert_eq!(discovery.registered_count(), 2);
+        assert_eq!(discovery.report.stop_reason, StopReason::TupleLimit);
+        assert_eq!(discovery.report.search_calls, 0);
+        assert_eq!(
+            discovery.batch(&mut graph, 64, Instant::now() + Duration::from_secs(2)),
+            0
+        );
+    }
+
+    #[test]
+    fn work_limits_reset_on_refresh_but_registered_tuple_limit_does_not() {
+        let mut graph = dots(3);
+        let limits = SearchLimits {
+            raw_matches: 1,
+            search_calls: 100,
+            attempts: 1,
+        };
+        let mut discovery = discover(&graph, vec![pair()], 1, limits, None);
+        assert_eq!(discovery.report.raw_matches, 1);
+        assert_eq!(
+            discovery.batch(&mut graph, 1, Instant::now() + Duration::from_secs(2)),
+            1
+        );
+        discovery.refresh(&graph);
+        assert_eq!(discovery.report.raw_matches, 0);
+        assert_eq!(discovery.report.search_calls, 0);
+        assert_eq!(discovery.report.stop_reason, StopReason::TupleLimit);
+        assert_eq!(discovery.registered_count(), 1);
+        assert!(discovery.pending.is_empty());
+    }
+}
