+struct InstructionStream {
+    anchors: Vec<Id>,
+    position: usize,
+    cursor: Option<MatchCursor>,
+    anchored_query: Option<MultiPattern<TensorOp>>,
+    active: bool,
+}
+
+enum StreamStep {
+    Match(Subst),
+    Pending,
+    Exhausted,
+    Truncated(StopReason),
+}
+
+impl InstructionStream {
+    fn new(graph: &EGraph<TensorOp, TensorInfo>, query: &JointQuery<'_>) -> Self {
+        let mut anchors: Vec<_> = graph
+            .classes()
+            .filter(|class| query.compatible(graph, query.first, class.id))
+            .map(|class| class.id)
+            .collect();
+        anchors.sort_unstable();
+        let active = !anchors.is_empty();
+        Self {
+            anchors,
+            position: 0,
+            cursor: None,
+            anchored_query: None,
+            active,
+        }
+    }
+
+    /// One candidate or one unsuccessful egg call is one scheduling quantum.
+    fn step(
+        &mut self,
+        graph: &EGraph<TensorOp, TensorInfo>,
+        query: &JointQuery<'_>,
+        budget: &mut SearchBudget,
+    ) -> StreamStep {
+        if !self.active {
+            return StreamStep::Exhausted;
+        }
+        let anchor = self.anchors[self.position];
+        if self.cursor.is_none() {
+            self.cursor = Some(MatchCursor::new(anchor));
+            if query.query.is_none() {
+                self.anchored_query = Some(joint_query(
+                    &query.asts,
+                    &query.roots,
+                    query.first,
+                    graph[anchor].nodes.first(),
+                ));
+            }
+        }
+        let pattern = query
+            .query
+            .as_ref()
+            .or(self.anchored_query.as_ref())
+            .unwrap();
+        match self.cursor.as_mut().unwrap().step(graph, pattern, budget) {
+            SearchStep::Match { subst, .. } => StreamStep::Match(subst),
+            SearchStep::Truncated(reason) => {
+                self.active = false;
+                StreamStep::Truncated(reason)
+            }
+            SearchStep::Exhausted => {
+                self.position += 1;
+                self.cursor = None;
+                self.anchored_query = None;
+                self.active = self.position < self.anchors.len();
+                if self.active {
+                    StreamStep::Pending
+                } else {
+                    StreamStep::Exhausted
+                }
+            }
+        }
+    }
+}
