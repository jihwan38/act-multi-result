+//! Budgeted access to egg's non-preemptible MultiPattern search.
+//!
+//! A cursor belongs to one query, anchor, and immutable graph snapshot. Prefix
+//! replay is unavoidable with egg's public API and is charged as real work.
+use std::collections::VecDeque;
+use std::time::Instant;
+
+use crate::ir::egraph::{TensorInfo, TensorOp};
+use egg::{EGraph, Id, MultiPattern, Searcher, Subst};
+use serde::Serialize;
+
+/// Work limits scoped by the owner; Discovery creates one budget per refresh.
+/// They are independent of its monotonic lifetime registered-tuple cap.
+#[derive(Clone, Copy, Debug, Serialize)]
+pub struct SearchLimits {
+    pub raw_matches: usize,
+    pub search_calls: usize,
+    pub attempts: usize,
+}
+
+impl Default for SearchLimits {
+    fn default() -> Self {
+        Self {
+            raw_matches: 4096,
+            search_calls: 4096,
+            attempts: 4096,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum StopReason {
+    Exhausted,
+    CandidateTarget,
+    TupleLimit,
+    RawMatchLimit,
+    SearchCallLimit,
+    AttemptLimit,
+    Deadline,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct SearchReport {
+    pub limits: SearchLimits,
+    pub search_calls: usize,
+    /// Includes every returned substitution, including replayed prefixes.
+    pub raw_matches: usize,
+    pub replayed_matches: usize,
+    pub attempts: usize,
+    pub rejected_types: usize,
+    pub rejected_inputs: usize,
+    pub duplicates: usize,
+    pub accepted: usize,
+    pub registered: usize,
+    pub complete: bool,
+    pub pending_work: bool,
+    pub stop_reason: StopReason,
+}
+
+pub struct SearchBudget {
+    limits: SearchLimits,
+    deadline: Option<Instant>,
+    pub report: SearchReport,
+}
+
+impl SearchBudget {
+    pub fn new(limits: SearchLimits, deadline: Option<Instant>) -> Self {
+        Self {
+            limits,
+            deadline,
+            report: SearchReport {
+                limits,
+                search_calls: 0,
+                raw_matches: 0,
+                replayed_matches: 0,
+                attempts: 0,
+                rejected_types: 0,
+                rejected_inputs: 0,
+                duplicates: 0,
+                accepted: 0,
+                registered: 0,
+                complete: false,
+                pending_work: true,
+                stop_reason: StopReason::Exhausted,
+            },
+        }
+    }
+
+    pub fn deadline(&self) -> Option<Instant> {
+        self.deadline
+    }
+
+    pub fn check_deadline(&self) -> Result<(), StopReason> {
+        if self.deadline.is_some_and(|end| Instant::now() >= end) {
+            Err(StopReason::Deadline)
+        } else {
+            Ok(())
+        }
+    }
+
+    pub fn try_attempt(&mut self) -> Result<(), StopReason> {
+        self.check_deadline()?;
+        if self.report.attempts >= self.limits.attempts {
+            return Err(StopReason::AttemptLimit);
+        }
+        self.report.attempts += 1;
+        Ok(())
+    }
+
+    fn allowance(&self, consumed: usize, desired: usize) -> Result<usize, StopReason> {
+        self.check_deadline()?;
+        if self.report.search_calls >= self.limits.search_calls {
+            return Err(StopReason::SearchCallLimit);
+        }
+        let remaining = self
+            .limits
+            .raw_matches
+            .saturating_sub(self.report.raw_matches);
+        if remaining <= consumed {
+            // One more item requires replaying `consumed` earlier matches.
+            return Err(StopReason::RawMatchLimit);
+        }
+        Ok(desired.min(remaining))
+    }
+
+    pub fn finish(&mut self, reason: StopReason) {
+        self.report.stop_reason = reason;
+        self.report.complete = reason == StopReason::Exhausted;
+        self.report.pending_work = !self.report.complete;
+    }
+}
+
+pub enum SearchStep {
+    Match { anchor: Id, subst: Subst },
+    Exhausted,
+    Truncated(StopReason),
+}
+
+/// Owns no graph borrow, but must never be resumed against a changed snapshot.
+/// The caller may supply an anchor-specific query (needed for bare identities).
+pub struct MatchCursor {
+    anchor: Id,
+    consumed: usize,
+    prefix_len: usize,
+    buffered: VecDeque<Subst>,
+    finished: bool,
+}
+
+impl MatchCursor {
+    pub fn new(anchor: Id) -> Self {
+        Self {
+            anchor,
+            consumed: 0,
+            prefix_len: 0,
+            buffered: VecDeque::new(),
+            finished: false,
+        }
+    }
+
+    /// Performs at most one egg search. Returned prefixes retain egg's order:
+    /// sorting a growing prefix before skipping `consumed` would lose matches.
+    pub fn step(
+        &mut self,
+        graph: &EGraph<TensorOp, TensorInfo>,
+        query: &MultiPattern<TensorOp>,
+        budget: &mut SearchBudget,
+    ) -> SearchStep {
+        if let Err(reason) = budget.check_deadline() {
+            return SearchStep::Truncated(reason);
+        }
+        if let Some(subst) = self.buffered.pop_front() {
+            self.consumed += 1;
+            return SearchStep::Match {
+                anchor: self.anchor,
+                subst,
+            };
+        }
+        if self.finished {
+            return SearchStep::Exhausted;
+        }
+        let desired = self.prefix_len.saturating_mul(2).max(1);
+        let requested = match budget.allowance(self.consumed, desired) {
+            Ok(value) => value,
+            Err(reason) => return SearchStep::Truncated(reason),
+        };
+        // No cancellation callback exists in egg 0.10. A single call can exceed
+        // the deadline or do expensive work even when it returns zero matches.
+        let substs = query
+            .search_eclass_with_limit(graph, self.anchor, requested)
+            .map(|matches| matches.substs)
+            .unwrap_or_default();
+        budget.report.search_calls += 1;
+        budget.report.raw_matches += substs.len();
+        budget.report.replayed_matches += self.consumed.min(substs.len());
+        assert!(
+            substs.len() >= self.consumed,
+            "search cursor snapshot/query changed"
+        );
+        self.finished = substs.len() < requested;
+        self.prefix_len = substs.len();
+        self.buffered = substs.into_iter().skip(self.consumed).collect();
+        if let Err(reason) = budget.check_deadline() {
+            return SearchStep::Truncated(reason);
+        }
+        if let Some(subst) = self.buffered.pop_front() {
+            self.consumed += 1;
+            SearchStep::Match {
+                anchor: self.anchor,
+                subst,
+            }
+        } else {
+            SearchStep::Exhausted
+        }
+    }
+}
