+#[cfg(test)]
+mod tests {
+    use super::*;
+    use egg::Runner;
+
+    fn matrix(graph: &mut Graph, op: TensorOp) -> Id {
+        let id = graph.add(op);
+        graph.set_analysis_data(
+            id,
+            TensorInfo {
+                shape: vec![64, 64],
+                dtype: Dtype::BF16,
+                is_const: false,
+            },
+        );
+        id
+    }
+
+    fn limits(value: usize) -> SearchLimits {
+        SearchLimits {
+            raw_matches: value,
+            search_calls: value,
+            attempts: value,
+        }
+    }
+
+    fn identity_gate(graph: &Graph, ids: &Vec<Id>) -> bool {
+        ids.len() == 2
+            && ids.iter().all(|&id| {
+                tuple_elements(graph, id).is_none()
+                    && graph[id].data.dtype == Dtype::BF16
+                    && graph[id].data.shape == [64, 64]
+            })
+    }
+
+    fn reject(_: &Graph, _: &Vec<Id>) -> bool {
+        false
+    }
+
+    fn identity_rule(
+        name: &str,
+        control: DirectControl,
+        precondition: fn(&Graph, &Vec<Id>) -> bool,
+    ) -> Rewrite<TensorOp, TensorInfo> {
+        // A logical tuple constructor is sufficient to test search/application
+        // bookkeeping without depending on any generated target's ISA enum.
+        rewrite(
+            name,
+            "(tuple ?p0 ?p1)".parse().unwrap(),
+            "(tuple ?p0 ?p1)".parse().unwrap(),
+            vec![(Dtype::BF16, vec![Some(64), Some(64)]); 2],
+            Functions {
+                precondition,
+                metadata: |_, _, _| vec![None; 3],
+                set_shapes: |_, _, _| {},
+            },
+            control,
+        )
+    }
+
+    fn seed_tuple(graph: &mut Graph, values: [Id; 2]) {
+        let tuple = graph.add(TensorOp::OpTuple(values.to_vec()));
+        for (index, value) in values.into_iter().enumerate() {
+            let projection = graph.add(TensorOp::OpGetTupleElement(index, [tuple]));
+            graph.set_analysis_data(projection, graph[value].data.clone());
+            graph.union(value, projection);
+        }
+        graph.rebuild();
+    }
+
+    #[test]
+    fn expanded_binding_order_preserves_shared_and_repeated_operands() {
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        let square = matrix(&mut graph, TensorOp::OpMultiply([a, a]));
+        matrix(&mut graph, TensorOp::OpMultiply([a, b]));
+        let copy = matrix(&mut graph, TensorOp::OpCopy([a]));
+        graph.rebuild();
+        let lhs = "(tuple (multiply ?p0 ?p0__use1) (copy ?p0__use2))"
+            .parse()
+            .unwrap();
+        let plan = MatchPlan::new(&lhs);
+        let query = plan.query(&graph, square);
+        let found = query.search_eclass(&graph, square).unwrap();
+        assert_eq!(found.substs.len(), 1);
+        assert_eq!(
+            plan.ids(&graph, &found.substs[0]),
+            vec![a, a, square, a, copy]
+        );
+        assert_eq!(plan.results(&graph, &found.substs[0]), vec![square, copy]);
+    }
+
+    #[test]
+    fn nested_metadata_wildcards_keep_expanded_result_order() {
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let first = matrix(&mut graph, TensorOp::OpReshape("32,128".into(), [a]));
+        let inner = matrix(&mut graph, TensorOp::OpReshape("16,256".into(), [a]));
+        let second = matrix(&mut graph, TensorOp::OpCopy([inner]));
+        graph.rebuild();
+        let lhs = "(tuple (reshape_? ?p0) (copy (reshape_? ?p0__use1)))"
+            .parse()
+            .unwrap();
+        let plan = MatchPlan::new(&lhs);
+        let query = plan.query(&graph, first);
+        let found = query.search_eclass(&graph, first).unwrap();
+        assert!(found
+            .substs
+            .iter()
+            .any(|subst| plan.ids(&graph, subst) == vec![a, first, a, inner, second]));
+    }
+
+    #[test]
+    fn rejecting_full_preconditions_never_materializes_a_candidate_tuple() {
+        let mut graph = Graph::default();
+        matrix(&mut graph, TensorOp::Var("a".into()));
+        graph.rebuild();
+        let before = graph.total_size();
+        let control = DirectControl::new(limits(64), 4, None);
+        let rule = identity_rule("rejecting", control.clone(), reject);
+        assert!(rule.search(&graph).is_empty());
+        assert_eq!(graph.total_size(), before);
+        assert_eq!(control.report().rejected_preconditions, 1);
+        assert!(control.report().complete);
+    }
+
+    #[test]
+    fn no_op_prefix_does_not_falsely_saturate_before_a_new_candidate() {
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        seed_tuple(&mut graph, [a, a]);
+        seed_tuple(&mut graph, [a, b]);
+        let control = DirectControl::new(limits(128), 1, None);
+        let rule = identity_rule("identity", control.clone(), identity_gate);
+        let runner = Runner::default()
+            .with_egraph(graph)
+            .with_scheduler(control.scheduler())
+            .with_iter_limit(8)
+            .run(&[rule]);
+        assert!(runner.iterations.len() >= 2);
+        assert_eq!(control.report().applications, 1);
+        assert!(runner.egraph.classes().any(|class| class.nodes.iter().any(|node|
+            matches!(node, TensorOp::OpTuple(ids) if runner.egraph.find(ids[0]) == runner.egraph.find(b)))));
+    }
+
+    #[test]
+    fn a_broad_rejected_rule_cannot_spend_a_later_rules_share() {
+        let mut graph = Graph::default();
+        for i in 0..4 {
+            matrix(&mut graph, TensorOp::Var(format!("v{i}")));
+        }
+        graph.rebuild();
+        let control = DirectControl::new(limits(16), 2, None);
+        let first = identity_rule("first", control.clone(), reject);
+        let later = identity_rule("later", control.clone(), identity_gate);
+        let runner = Runner::default()
+            .with_egraph(graph)
+            .with_scheduler(control.scheduler())
+            .with_iter_limit(8)
+            .run(&[first, later]);
+        let report = control.report();
+        assert_eq!(report.rules["first"].application_limit, 1);
+        assert_eq!(report.rules["later"].application_limit, 1);
+        assert_eq!(report.rules["first"].applications, 0);
+        assert_eq!(report.rules["later"].applications, 1);
+        assert!(report.rules["first"].disabled.is_some());
+        assert!(report.rule_search.values().all(|r| r.raw_matches <= 8));
+        assert!(report.search.raw_matches <= 16);
+        assert!(!report.complete);
+        assert!(runner.egraph.classes().any(|class| class
+            .nodes
+            .iter()
+            .any(|node| matches!(node, TensorOp::OpTuple(_)))));
+    }
+
+    #[test]
+    fn useful_application_quota_is_reserved_for_each_rule() {
+        let mut graph = Graph::default();
+        matrix(&mut graph, TensorOp::Var("a".into()));
+        matrix(&mut graph, TensorOp::Var("b".into()));
+        graph.rebuild();
+        let control = DirectControl::new(limits(256), 2, None);
+        let first = identity_rule("first", control.clone(), identity_gate);
+        let later = identity_rule("later", control.clone(), identity_gate);
+        Runner::default()
+            .with_egraph(graph)
+            .with_scheduler(control.scheduler())
+            .with_iter_limit(8)
+            .run(&[first, later]);
+        let report = control.report();
+        assert_eq!(report.rules["first"].applications, 1);
+        assert_eq!(report.rules["later"].applications, 1);
+        assert_eq!(report.applications, 2);
+        assert!(report.disabled);
+    }
+}
