+#[derive(Clone, Debug, Serialize)]
+pub struct RuleReport {
+    pub searches: usize,
+    pub limits: SearchLimits,
+    pub application_limit: usize,
+    pub applications: usize,
+    pub disabled: Option<StopReason>,
+    pub stop_reason: StopReason,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct DirectReport {
+    pub policy: &'static str,
+    pub completeness_scope: &'static str,
+    pub runner_stop: Option<String>,
+    pub application_limit: usize,
+    pub applications: usize,
+    pub apply_attempts: usize,
+    pub rejected_preconditions: usize,
+    pub rejected_at_apply: usize,
+    pub disabled: bool,
+    pub complete: bool,
+    pub pending_work: bool,
+    pub rules: BTreeMap<String, RuleReport>,
+    pub rule_search: BTreeMap<String, SearchReport>,
+    pub search: SearchReport,
+}
+
+struct ControlState {
+    budget: SearchBudget,
+    application_limit: usize,
+    applications: usize,
+    apply_attempts: usize,
+    rejected_preconditions: usize,
+    rejected_at_apply: usize,
+    rules: BTreeMap<String, RuleReport>,
+    rule_order: Vec<String>,
+    rule_budgets: BTreeMap<String, SearchBudget>,
+    partitioned: bool,
+    seen: HashSet<AppliedKey>,
+}
+
+impl ControlState {
+    fn partition(&mut self) {
+        if self.partitioned {
+            return;
+        }
+        self.partitioned = true;
+        let count = self.rule_order.len();
+        if count == 0 {
+            return;
+        }
+        let total = self.budget.report.limits;
+        let share = |value: usize, index: usize| value / count + usize::from(index < value % count);
+        for (index, name) in self.rule_order.iter().enumerate() {
+            let limits = SearchLimits {
+                raw_matches: share(total.raw_matches, index),
+                search_calls: share(total.search_calls, index),
+                attempts: share(total.attempts, index),
+            };
+            let rule = self.rules.get_mut(name).unwrap();
+            rule.limits = limits;
+            rule.application_limit = share(self.application_limit, index);
+            self.rule_budgets.insert(
+                name.clone(),
+                SearchBudget::new(limits, self.budget.deadline()),
+            );
+        }
+    }
+
+    fn disable_rule(&mut self, name: &str, reason: StopReason) {
+        let rule = self.rules.get_mut(name).unwrap();
+        rule.disabled.get_or_insert(reason);
+        rule.stop_reason = rule.disabled.unwrap();
+    }
+
+    fn merge_budget(&mut self, name: &str, budget: SearchBudget) {
+        self.rule_budgets.insert(name.into(), budget);
+        let total = &mut self.budget.report;
+        total.search_calls = 0;
+        total.raw_matches = 0;
+        total.replayed_matches = 0;
+        total.attempts = 0;
+        total.rejected_types = 0;
+        total.rejected_inputs = 0;
+        total.duplicates = 0;
+        total.accepted = 0;
+        for budget in self.rule_budgets.values() {
+            let report = &budget.report;
+            total.search_calls += report.search_calls;
+            total.raw_matches += report.raw_matches;
+            total.replayed_matches += report.replayed_matches;
+            total.attempts += report.attempts;
+            total.rejected_types += report.rejected_types;
+            total.rejected_inputs += report.rejected_inputs;
+            total.duplicates += report.duplicates;
+            total.accepted += report.accepted;
+        }
+    }
+
+    fn finish_rule(&mut self, name: &str, reason: StopReason) {
+        let rule = self.rules.get_mut(name).unwrap();
+        rule.stop_reason = rule.disabled.unwrap_or(reason);
+        if let Some(budget) = self.rule_budgets.get_mut(name) {
+            budget.finish(rule.stop_reason);
+        }
+        let reason = self
+            .rules
+            .values()
+            .find_map(|rule| rule.disabled)
+            .unwrap_or_else(|| {
+                if self
+                    .rules
+                    .values()
+                    .all(|r| r.searches > 0 && r.stop_reason == StopReason::Exhausted)
+                {
+                    StopReason::Exhausted
+                } else {
+                    StopReason::CandidateTarget
+                }
+            });
+        self.budget.finish(reason);
+    }
+
+    fn canonicalize(&mut self, graph: &Graph) {
+        self.seen = self.seen.iter().map(|key| key.canonical(graph)).collect();
+    }
+}
+
+/// Monotonic lifetime limits partitioned equally across generated joint rules.
+/// Declaration order receives integer remainders. Unused shares are not borrowed,
+/// so an early broad ISA cannot consume a later rule's work/application budget.
+/// Ordinary scalar and IR rules continue when any/all joint shares are exhausted.
+#[derive(Clone)]
+pub struct DirectControl(Arc<Mutex<ControlState>>);
+
+impl DirectControl {
+    pub fn new(limits: SearchLimits, application_limit: usize, deadline: Option<Instant>) -> Self {
+        Self(Arc::new(Mutex::new(ControlState {
+            budget: SearchBudget::new(limits, deadline),
+            application_limit,
+            applications: 0,
+            apply_attempts: 0,
+            rejected_preconditions: 0,
+            rejected_at_apply: 0,
+            rules: BTreeMap::new(),
+            rule_order: Vec::new(),
+            rule_budgets: BTreeMap::new(),
+            partitioned: false,
+            seen: HashSet::new(),
+        })))
+    }
+
+    pub fn from_env(deadline: Option<Instant>) -> Self {
+        fn setting(name: &str, default: usize) -> usize {
+            std::env::var(name)
+                .ok()
+                .map(|text| text.parse().expect(name))
+                .unwrap_or(default)
+        }
+        let defaults = SearchLimits::default();
+        Self::new(
+            SearchLimits {
+                raw_matches: setting("ACT_JOINT_RAW_LIMIT", defaults.raw_matches),
+                search_calls: setting("ACT_JOINT_SEARCH_LIMIT", defaults.search_calls),
+                attempts: setting("ACT_JOINT_ATTEMPT_LIMIT", defaults.attempts),
+            },
+            setting("ACT_JOINT_LIMIT", 64),
+            deadline,
+        )
+    }
+
+    fn register(&self, name: &str) {
+        let mut state = self.0.lock().unwrap();
+        if state.rules.contains_key(name) {
+            return;
+        }
+        assert!(
+            !state.partitioned,
+            "register all joint rules before using the control"
+        );
+        state.rule_order.push(name.into());
+        state.rules.insert(
+            name.into(),
+            RuleReport {
+                searches: 0,
+                limits: SearchLimits {
+                    raw_matches: 0,
+                    search_calls: 0,
+                    attempts: 0,
+                },
+                application_limit: 0,
+                applications: 0,
+                disabled: None,
+                stop_reason: StopReason::CandidateTarget,
+            },
+        );
+    }
+
+    /// Bounded joint search owns its limits; Backoff must not discard a useful
+    /// batch merely because its raw structural match count exceeds a threshold.
+    pub fn scheduler(&self) -> DirectScheduler {
+        let mut state = self.0.lock().unwrap();
+        state.partition();
+        let inner = state
+            .rules
+            .keys()
+            .fold(BackoffScheduler::default(), |scheduler, name| {
+                scheduler.do_not_ban(name.as_str())
+            });
+        DirectScheduler {
+            inner,
+            control: self.clone(),
+        }
+    }
+
+    pub fn report(&self) -> DirectReport {
+        let state = self.0.lock().unwrap();
+        let complete = state.rules.values().all(|r| {
+            r.disabled.is_none() && r.searches > 0 && r.stop_reason == StopReason::Exhausted
+        });
+        let mut search = state.budget.report.clone();
+        search.complete = complete;
+        search.pending_work = !complete;
+        DirectReport {
+            policy: "lifetime_equal_rule_shares",
+            completeness_scope: "last_search_snapshots",
+            runner_stop: None,
+            application_limit: state.application_limit,
+            applications: state.applications,
+            apply_attempts: state.apply_attempts,
+            rejected_preconditions: state.rejected_preconditions,
+            rejected_at_apply: state.rejected_at_apply,
+            disabled: !state.rules.is_empty()
+                && state.rules.values().all(|rule| rule.disabled.is_some()),
+            complete,
+            pending_work: !complete,
+            rules: state.rules.clone(),
+            rule_search: state
+                .rule_budgets
+                .iter()
+                .map(|(name, budget)| (name.clone(), budget.report.clone()))
+                .collect(),
+            search,
+        }
+    }
+
+    pub fn print_report(&self) {
+        println!(
+            "ACT_DIRECT_REWRITE {}",
+            serde_json::to_string(&self.report()).unwrap()
+        );
+    }
+
+    pub fn print_final_report(&self, runner_stop: &egg::StopReason) {
+        let mut report = self.report();
+        report.runner_stop = Some(format!("{runner_stop:?}"));
+        println!(
+            "ACT_DIRECT_REWRITE {}",
+            serde_json::to_string(&report).unwrap()
+        );
+    }
+}
+
+/// A capped useful-match prefix may consist entirely of existing producers.
+/// Applying it still advances the seen set, so allow the next bounded search
+/// before declaring saturation. A disabled lifetime budget has no such work.
+pub struct DirectScheduler {
+    inner: BackoffScheduler,
+    control: DirectControl,
+}
+
+impl RewriteScheduler<TensorOp, TensorInfo> for DirectScheduler {
+    fn can_stop(&mut self, iteration: usize) -> bool {
+        let pending = {
+            let state = self.control.0.lock().unwrap();
+            state.rules.values().any(|rule| {
+                rule.disabled.is_none()
+                    && rule.searches > 0
+                    && rule.stop_reason == StopReason::CandidateTarget
+            })
+        };
+        !pending
+            && <BackoffScheduler as RewriteScheduler<TensorOp, TensorInfo>>::can_stop(
+                &mut self.inner,
+                iteration,
+            )
+    }
+
+    fn search_rewrite<'a>(
+        &mut self,
+        iteration: usize,
+        graph: &Graph,
+        rewrite: &'a Rewrite<TensorOp, TensorInfo>,
+    ) -> Vec<SearchMatches<'a, TensorOp>> {
+        self.inner.search_rewrite(iteration, graph, rewrite)
+    }
+}
+
+#[derive(Clone)]
+struct JointRule {
+    name: String,
+    plan: Arc<MatchPlan>,
+    result_types: Vec<ResultType>,
+    rhs: Pattern<TensorOp>,
+    input_vars: Vec<Var>,
+    functions: Functions,
+    control: DirectControl,
+}
+
+impl JointRule {
+    fn compatible(&self, graph: &Graph, slot: usize, id: Id) -> bool {
+        let (dtype, shape) = &self.result_types[slot];
+        let info = &graph[id].data;
+        tuple_elements(graph, id).is_none()
+            && info.dtype == *dtype
+            && info.shape.len() == shape.len()
+            && info
+                .shape
+                .iter()
+                .zip(shape)
+                .all(|(actual, expected)| expected.is_none_or(|n| *actual == n))
+    }
+
+    fn key(&self, graph: &Graph, subst: &Subst, ids: &Vec<Id>) -> AppliedKey {
+        AppliedKey {
+            rule: self.name.clone(),
+            inputs: self
+                .input_vars
+                .iter()
+                .map(|var| graph.find(subst[*var]))
+                .collect(),
+            results: self.plan.results(graph, subst),
+            // Generated ISA metadata comes from semantic shapes/attributes;
+            // its _lhs_enodes argument is deliberately unused by the generator.
+            metadata: (self.functions.metadata)(graph, ids, &Vec::new()),
+        }
+    }
+
+    fn search_anchors<'a>(
+        &'a self,
+        graph: &Graph,
+        mut anchors: Vec<Id>,
+        limit: usize,
+    ) -> Vec<SearchMatches<'a, TensorOp>> {
+        if limit == 0 {
+            return Vec::new();
+        }
+        let mut state = self.control.0.lock().unwrap();
+        state.partition();
+        if state.rules[&self.name].disabled.is_some() {
+            return Vec::new();
+        }
+        let remaining = state.rules[&self.name]
+            .application_limit
+            .saturating_sub(state.rules[&self.name].applications);
+        if remaining == 0 {
+            state.disable_rule(&self.name, StopReason::TupleLimit);
+            state.finish_rule(&self.name, StopReason::TupleLimit);
+            return Vec::new();
+        }
+        if let Err(reason) = state.budget.check_deadline() {
+            state.disable_rule(&self.name, reason);
+            state.finish_rule(&self.name, reason);
+            return Vec::new();
+        }
+        let mut budget = state.rule_budgets.remove(&self.name).unwrap();
+        state.canonicalize(graph);
+        state.rules.get_mut(&self.name).unwrap().searches += 1;
+        anchors.sort();
+        anchors.dedup();
+        let mut cursors: VecDeque<_> = anchors
+            .into_iter()
+            .filter(|&id| self.compatible(graph, self.plan.first, id))
+            .map(|id| (id, MatchCursor::new(id)))
+            .collect();
+        let target = limit.min(remaining);
+        let mut count = 0;
+        let mut unique = HashSet::new();
+        let mut found: BTreeMap<Id, Vec<Subst>> = BTreeMap::new();
+        let mut truncation = None;
+        while let Some((anchor, mut cursor)) = cursors.pop_front() {
+            let query = self.plan.query(graph, anchor);
+            match cursor.step(graph, &query, &mut budget) {
+                SearchStep::Exhausted => continue,
+                SearchStep::Truncated(reason) => {
+                    truncation.get_or_insert(reason);
+                    continue;
+                }
+                SearchStep::Match { anchor, subst } => {
+                    if let Err(reason) = budget.try_attempt() {
+                        truncation.get_or_insert(reason);
+                        break;
+                    }
+                    cursors.push_back((anchor, cursor));
+                    if !self
+                        .plan
+                        .roots
+                        .iter()
+                        .enumerate()
+                        .all(|(slot, var)| self.compatible(graph, slot, subst[*var]))
+                    {
+                        budget.report.rejected_types += 1;
+                        continue;
+                    }
+                    let ids = self.plan.ids(graph, &subst);
+                    if !(self.functions.precondition)(graph, &ids) {
+                        state.rejected_preconditions += 1;
+                        continue;
+                    }
+                    if let Err(reason) = budget.check_deadline() {
+                        truncation.get_or_insert(reason);
+                        break;
+                    }
+                    let key = self.key(graph, &subst, &ids);
+                    if state.seen.contains(&key) || !unique.insert(key) {
+                        budget.report.duplicates += 1;
+                        continue;
+                    }
+                    found.entry(anchor).or_default().push(subst);
+                    count += 1;
+                    budget.report.accepted += 1;
+                    if count == target {
+                        break;
+                    }
+                }
+            }
+        }
+        let reason = if let Some(reason) = truncation {
+            state.disable_rule(&self.name, reason);
+            reason
+        } else if count == target {
+            StopReason::CandidateTarget
+        } else {
+            StopReason::Exhausted
+        };
+        budget.finish(reason);
+        state.merge_budget(&self.name, budget);
+        state.finish_rule(&self.name, reason);
+        found
+            .into_iter()
+            .map(|(eclass, substs)| SearchMatches {
+                eclass,
+                substs,
+                ast: None,
+            })
+            .collect()
+    }
+}
+
+impl Searcher<TensorOp, TensorInfo> for JointRule {
+    fn search_eclass_with_limit(
+        &self,
+        graph: &Graph,
+        eclass: Id,
+        limit: usize,
+    ) -> Option<SearchMatches<'_, TensorOp>> {
+        self.search_anchors(graph, vec![graph.find(eclass)], limit)
+            .pop()
+    }
+
+    fn search_with_limit(&self, graph: &Graph, limit: usize) -> Vec<SearchMatches<'_, TensorOp>> {
+        self.search_anchors(
+            graph,
+            graph.classes().map(|class| class.id).collect(),
+            limit,
+        )
+    }
+
+    fn vars(&self) -> Vec<Var> {
+        self.plan.variables.clone()
+    }
+}
+
+impl Applier<TensorOp, TensorInfo> for JointRule {
+    fn apply_one(
+        &self,
+        graph: &mut Graph,
+        _anchor: Id,
+        subst: &Subst,
+        _ast: Option<&PatternAst<TensorOp>>,
+        _name: Symbol,
+    ) -> Vec<Id> {
+        let mut state = self.control.0.lock().unwrap();
+        state.partition();
+        if state.rules[&self.name].applications >= state.rules[&self.name].application_limit {
+            state.disable_rule(&self.name, StopReason::TupleLimit);
+            state.finish_rule(&self.name, StopReason::TupleLimit);
+            return Vec::new();
+        }
+        if let Err(reason) = state.budget.check_deadline() {
+            state.disable_rule(&self.name, reason);
+            state.finish_rule(&self.name, reason);
+            return Vec::new();
+        }
+        state.apply_attempts += 1;
+        let ids = self.plan.ids(graph, subst);
+        // Search substitutions are snapshots. Recheck the complete ISA gate
+        // after preceding rewrites/unions and before any graph mutation.
+        if !(self.functions.precondition)(graph, &ids) {
+            state.rejected_at_apply += 1;
+            return Vec::new();
+        }
+        if let Err(reason) = state.budget.check_deadline() {
+            state.disable_rule(&self.name, reason);
+            state.finish_rule(&self.name, reason);
+            return Vec::new();
+        }
+        state.canonicalize(graph);
+        let key = self.key(graph, subst, &ids);
+        if !state.seen.insert(key.clone()) {
+            state
+                .rule_budgets
+                .get_mut(&self.name)
+                .unwrap()
+                .report
+                .duplicates += 1;
+            state.budget.report.duplicates += 1;
+            return Vec::new();
+        }
+        let results = key.results;
+        let infos: Vec<_> = results.iter().map(|&id| graph[id].data.clone()).collect();
+        let tuple = graph.add(TensorOp::OpTuple(results.clone()));
+        let mut rhs_ids = vec![0.into(); self.rhs.ast.len()];
+        let producer = super::applier::apply_pat(
+            graph,
+            self.rhs.ast.as_ref(),
+            &mut rhs_ids,
+            &key.metadata,
+            subst,
+        );
+        (self.functions.set_shapes)(graph, &ids, &rhs_ids);
+        let mut changed = Vec::new();
+        if graph.union(tuple, producer) {
+            changed.push(producer);
+        }
+        for (index, (&value, info)) in results.iter().zip(infos).enumerate() {
+            let projection = graph.add(TensorOp::OpGetTupleElement(index, [producer]));
+            graph.set_analysis_data(projection, info);
+            if graph.union(value, projection) {
+                changed.push(projection);
+            }
+        }
+        if !changed.is_empty() {
+            state.applications += 1;
+            state.budget.report.registered += 1;
+            state
+                .rule_budgets
+                .get_mut(&self.name)
+                .unwrap()
+                .report
+                .registered += 1;
+            let rule = state.rules.get_mut(&self.name).unwrap();
+            rule.applications += 1;
+            if rule.applications >= rule.application_limit {
+                state.disable_rule(&self.name, StopReason::TupleLimit);
+                state.finish_rule(&self.name, StopReason::TupleLimit);
+            }
+        }
+        changed
+    }
+
+    fn vars(&self) -> Vec<Var> {
+        let mut vars = self.plan.variables.clone();
+        vars.extend(self.rhs.vars());
+        vars.sort();
+        vars.dedup();
+        vars
+    }
+}
+
+pub(super) fn rewrite(
+    name: &str,
+    lhs: Pattern<TensorOp>,
+    rhs: Pattern<TensorOp>,
+    result_types: Vec<ResultType>,
+    functions: Functions,
+    control: DirectControl,
+) -> Rewrite<TensorOp, TensorInfo> {
+    let plan = Arc::new(MatchPlan::new(&lhs));
+    assert_eq!(plan.roots.len(), result_types.len());
+    let input_vars = rhs.vars();
+    control.register(name);
+    let rule = JointRule {
+        name: name.into(),
+        plan,
+        result_types,
+        rhs,
+        input_vars,
+        functions,
+        control,
+    };
+    Rewrite::new(name, rule.clone(), rule).unwrap()
+}
