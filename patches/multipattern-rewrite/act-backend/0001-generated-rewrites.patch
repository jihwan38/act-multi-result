+//! Generated multi-result rules: joint search, checked application, ordered ports.
+//!
+//! Matching never inserts speculative tuples. A successful application retains
+//! an OpTuple beside the ISA producer because extraction needs its result IDs.
+use std::borrow::Cow;
+use std::collections::{BTreeMap, HashSet, VecDeque};
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+use egg::{
+    Applier, BackoffScheduler, EGraph, ENodeOrVar, Id, Language, MultiPattern, Pattern, PatternAst,
+    Rewrite, RewriteScheduler, SearchMatches, Searcher, Subst, Symbol, Var,
+};
+use serde::Serialize;
+
+use crate::ir::dtype::Dtype;
+use crate::ir::egraph::{tuple_elements, TensorInfo, TensorOp};
+use crate::isel::bounded_search::{
+    MatchCursor, SearchBudget, SearchLimits, SearchReport, SearchStep, StopReason,
+};
+
+type Graph = EGraph<TensorOp, TensorInfo>;
+type ResultType = (Dtype, Vec<Option<i32>>);
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Functions {
+    pub precondition: fn(&Graph, &Vec<Id>) -> bool,
+    pub metadata: fn(&Graph, &Vec<Id>, &Vec<Option<TensorOp>>) -> Vec<Option<String>>,
+    pub set_shapes: fn(&mut Graph, &Vec<Id>, &Vec<Id>),
+}
+
+#[derive(Clone)]
+struct MatchPlan {
+    roots: Vec<Var>,
+    postorder: Vec<Var>,
+    variables: Vec<Var>,
+    clauses: Vec<Vec<(Var, PatternAst<TensorOp>)>>,
+    first: usize,
+    query: Option<MultiPattern<TensorOp>>,
+}
+
+fn input_var(var: Var) -> Var {
+    var.to_string()
+        .split("__use")
+        .next()
+        .unwrap()
+        .parse()
+        .unwrap()
+}
+
+impl MatchPlan {
+    fn new(lhs: &Pattern<TensorOp>) -> Self {
+        let ENodeOrVar::ENode(TensorOp::OpTuple(children)) = &lhs.ast[lhs.ast.root()] else {
+            panic!("multi-result rule requires an ordered tuple semantic root");
+        };
+        assert!(children.len() >= 2);
+        let roots: Vec<Var> = (0..children.len())
+            .map(|i| format!("?__act_result_{i}").parse().unwrap())
+            .collect();
+        let mut serial = 0;
+        let mut postorder = Vec::new();
+        let mut clauses = Vec::new();
+        // Retain expanded semantic occurrence order, even though PatternAst is
+        // a DAG. Generated preconditions index this exact tree postorder.
+        fn append(
+            ast: &PatternAst<TensorOp>,
+            id: Id,
+            binder: Var,
+            serial: &mut usize,
+            clauses: &mut Vec<(Var, PatternAst<TensorOp>)>,
+            postorder: &mut Vec<Var>,
+        ) {
+            match &ast[id] {
+                ENodeOrVar::Var(var) => {
+                    let mut alias = PatternAst::default();
+                    alias.add(ENodeOrVar::Var(input_var(*var)));
+                    clauses.push((binder, alias));
+                }
+                ENodeOrVar::ENode(node) => {
+                    let mut ast_part = PatternAst::default();
+                    let mut children = Vec::new();
+                    let shallow = node.clone().map_children(|child| {
+                        let var = format!("?__act_edge_{}", *serial).parse().unwrap();
+                        *serial += 1;
+                        children.push((child, var));
+                        ast_part.add(ENodeOrVar::Var(var))
+                    });
+                    ast_part.add(ENodeOrVar::ENode(shallow));
+                    // Fresh child variables keep ACT metadata wildcards away
+                    // from egg's exact Lookup optimization.
+                    clauses.push((binder, ast_part));
+                    for (child, var) in children {
+                        append(ast, child, var, serial, clauses, postorder);
+                    }
+                }
+            }
+            postorder.push(binder);
+        }
+        for (&child, &root) in children.iter().zip(&roots) {
+            let mut part = Vec::new();
+            append(
+                &lhs.ast,
+                child,
+                root,
+                &mut serial,
+                &mut part,
+                &mut postorder,
+            );
+            clauses.push(part);
+        }
+        let first_operator = children
+            .iter()
+            .position(|id| matches!(&lhs.ast[*id], ENodeOrVar::ENode(_)));
+        let first = first_operator.unwrap_or(0);
+        let mut plan = Self {
+            roots,
+            postorder,
+            variables: Vec::new(),
+            clauses,
+            first,
+            query: None,
+        };
+        let mut variables = HashSet::new();
+        for (binder, ast) in plan.clauses.iter().flatten() {
+            variables.insert(*binder);
+            for node in ast.as_ref() {
+                if let ENodeOrVar::Var(var) = node {
+                    variables.insert(*var);
+                }
+            }
+        }
+        plan.variables = variables.into_iter().collect();
+        plan.variables.sort();
+        if first_operator.is_some() {
+            plan.query = Some(plan.compile(None));
+        }
+        plan
+    }
+
+    fn compile(&self, anchor: Option<&TensorOp>) -> MultiPattern<TensorOp> {
+        let mut clauses = Vec::new();
+        if let Some(node) = anchor {
+            // egg 0.10 rejects a bare variable as its first clause. Anchor an
+            // all-identity rule in a real node of the searched e-class.
+            let mut ast = PatternAst::default();
+            let mut index = 0;
+            let shallow = node.clone().map_children(|_| {
+                let var = format!("?__act_anchor_{index}").parse().unwrap();
+                index += 1;
+                ast.add(ENodeOrVar::Var(var))
+            });
+            ast.add(ENodeOrVar::ENode(shallow));
+            clauses.push((self.roots[self.first], ast));
+        }
+        for slot in std::iter::once(self.first)
+            .chain((0..self.clauses.len()).filter(|&slot| slot != self.first))
+        {
+            clauses.extend(self.clauses[slot].iter().cloned());
+        }
+        MultiPattern::new(clauses)
+    }
+
+    fn query<'a>(&'a self, graph: &Graph, anchor: Id) -> Cow<'a, MultiPattern<TensorOp>> {
+        if let Some(query) = &self.query {
+            Cow::Borrowed(query)
+        } else {
+            Cow::Owned(self.compile(graph[anchor].nodes.first()))
+        }
+    }
+
+    fn ids(&self, graph: &Graph, subst: &Subst) -> Vec<Id> {
+        self.postorder
+            .iter()
+            .map(|var| graph.find(subst[*var]))
+            .collect()
+    }
+
+    fn results(&self, graph: &Graph, subst: &Subst) -> Vec<Id> {
+        self.roots
+            .iter()
+            .map(|var| graph.find(subst[*var]))
+            .collect()
+    }
+}
