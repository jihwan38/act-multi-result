+#[derive(Clone, PartialEq, Eq, Hash)]
+struct AppliedKey {
+    rule: String,
+    inputs: Vec<Id>,
+    results: Vec<Id>,
+    metadata: Vec<Option<String>>,
+}
+
+impl AppliedKey {
+    fn canonical(&self, graph: &Graph) -> Self {
+        Self {
+            rule: self.rule.clone(),
+            inputs: self.inputs.iter().map(|&id| graph.find(id)).collect(),
+            results: self.results.iter().map(|&id| graph.find(id)).collect(),
+            metadata: self.metadata.clone(),
+        }
+    }
+}
