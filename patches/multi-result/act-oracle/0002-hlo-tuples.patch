+def _validate_value_tree(tree, count):
+    leaves = []
+    def visit(node):
+        if isinstance(node, list):
+            for child in node:
+                visit(child)
+        elif type(node) is int:
+            leaves.append(node)
+        else:
+            raise ValueError("Value tree must contain only lists and integer leaf indices")
+    visit(tree)
+    if leaves != list(range(count)):
+        raise ValueError("Value tree must enumerate ABI leaves exactly once, in order")
+
+
+def _flatten_arguments(tree, value):
+    if type(tree) is int:
+        return [value]
+    if not isinstance(value, (tuple, list)) or len(tree) != len(value):
+        raise ValueError("Argument tuple structure differs from input_tree")
+    return [leaf for child, item in zip(tree, value) for leaf in _flatten_arguments(child, item)]
+
+
+def _restore_value(tree, leaves):
+    if type(tree) is int:
+        return leaves[tree]
+    return tuple(_restore_value(child, leaves) for child in tree)
+
+
+def kernel(hbm: int, input: list, output: list, constant=[], *, input_tree=None, output_tree=None):
+    # Existing fsim callers keep the flat output ABI. fsim-tree additionally
+    # restores the exact logical result, including nested/empty tuples.
+    if input_tree is not None:
+        if not isinstance(input_tree, list):
+            raise ValueError("input_tree must describe a parameter list")
+        _validate_value_tree(input_tree, len(input))
+    if output_tree is not None:
+        _validate_value_tree(output_tree, len(output))
