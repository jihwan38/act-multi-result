+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pending_candidates_defer_only_the_stall_heuristic() {
+        let improved = Duration::from_millis(100);
+        let elapsed = Duration::from_millis(250);
+        assert!(!stalled(elapsed, improved, 77));
+        assert!(stalled(elapsed, improved, 0));
+        assert!(!stalled(Duration::from_millis(150), improved, 0));
+        assert_eq!(TIME_LIMIT, Duration::from_secs(10));
+    }
+}
