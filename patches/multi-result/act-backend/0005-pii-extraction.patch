+/// A bounded run reports exhaustion, never claims complete enumeration after
+/// a timeout. Fast and slow share this budget when called by extract().
+pub(super) struct Budget {
+    pub visits: usize,
+    pub exhausted: bool,
+    visit_limit: usize,
+    deadline: Instant,
+}
+
+impl Budget {
+    pub fn new() -> Self {
+        let millis = std::env::var("ACT_PII_TIME_MS")
+            .ok()
+            .map(|x| x.parse().expect("Invalid extraction time limit"))
+            .unwrap_or(500);
+        Self {
+            visits: 0,
+            exhausted: false,
+            visit_limit: std::env::var("ACT_PII_VISITS")
+                .ok()
+                .map(|x| x.parse().expect("Invalid extraction visit limit"))
+                .unwrap_or(100_000),
+            deadline: Instant::now() + Duration::from_millis(millis),
+        }
+    }
+
+    pub fn step(&mut self) -> bool {
+        if self.visits >= self.visit_limit || Instant::now() >= self.deadline {
+            self.exhausted = true;
+            return false;
+        }
+        self.visits += 1;
+        true
+    }
+}
