+/// Look through logical projections without deleting their ISA alternatives.
+pub(super) fn value_id(graph: &EGraph<TensorOp, TensorInfo>, id: Id) -> Id {
+    let mut id = graph.find(id);
+    let mut seen = HashSet::new();
+    while seen.insert(id) {
+        let next = graph[id].nodes.iter().find_map(|op| {
+            if let TensorOp::OpGetTupleElement(index, [tuple]) = op {
+                let child = graph.find(*tuple_elements(graph, *tuple)?.get(*index)?);
