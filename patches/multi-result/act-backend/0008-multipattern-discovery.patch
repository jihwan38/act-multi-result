+#[cfg(test)]
+mod tests {
+    use super::joint_matches;
+    use crate::ir::dtype::Dtype;
+    use crate::ir::egraph::{TensorInfo, TensorOp};
+    use egg::{EGraph, Id};
+    use std::collections::HashSet;
+
+    type Graph = EGraph<TensorOp, TensorInfo>;
+
+    fn tensor(graph: &mut Graph, op: TensorOp, shape: &[i32]) -> Id {
+        let id = graph.add(op);
+        graph.set_analysis_data(
+            id,
+            TensorInfo {
+                dtype: Dtype::BF16,
+                shape: shape.to_vec(),
+                is_const: false,
+            },
+        );
+        id
+    }
+
+    fn matrix(graph: &mut Graph, op: TensorOp) -> Id {
+        tensor(graph, op, &[64, 64])
+    }
+
+    fn result_pairs(
+        graph: &Graph,
+        patterns: &[(&str, Dtype, Vec<Option<i32>>)],
+    ) -> HashSet<[Id; 2]> {
+        joint_matches(graph, patterns, 64)
+            .into_iter()
+            .map(|matched| {
+                assert_eq!(matched.len(), 2);
+                [graph.find(matched[0].id), graph.find(matched[1].id)]
+            })
+            .collect()
+    }
+
+    #[test]
+    fn joint_results_require_the_same_shared_input_eclass() {
+        // An ISA returns dot(x, a) and dot(x, b). Two products with different
+        // x inputs cannot implement it, although each result pattern matches.
+        let mut graph = Graph::default();
+        let [x, other_x, a, b] =
+            ["x", "other_x", "a", "b"].map(|name| matrix(&mut graph, TensorOp::Var(name.into())));
+        let first = matrix(&mut graph, TensorOp::OpDot([x, a]));
+        let valid_second = matrix(&mut graph, TensorOp::OpDot([x, b]));
+        let wrong_second = matrix(&mut graph, TensorOp::OpDot([other_x, b]));
+        graph.rebuild();
+        let patterns = [
+            ("(dot ?p0 ?p1)", Dtype::BF16, vec![Some(64), Some(64)]),
+            ("(dot ?p0 ?p2)", Dtype::BF16, vec![Some(64), Some(64)]),
+        ];
+
+        let found = result_pairs(&graph, &patterns);
+        assert!(found.contains(&[graph.find(first), graph.find(valid_second)]));
+        assert!(!found.contains(&[graph.find(first), graph.find(wrong_second)]));
+        assert!(!found.contains(&[graph.find(wrong_second), graph.find(first)]));
+
+        // Equality established by another rewrite is sufficient; the shared
+        // input is an e-class constraint, not the spelling of an input name.
+        graph.union(x, other_x);
+        graph.rebuild();
+        let found = result_pairs(&graph, &patterns);
+        assert!(found.contains(&[graph.find(first), graph.find(wrong_second)]));
+    }
+
+    #[test]
+    fn repeated_operand_occurrences_cannot_bind_different_inputs() {
+        // One input is used twice by multiply and again by the second result.
+        // Occurrence aliases in generated patterns still denote that one input.
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        let square = matrix(&mut graph, TensorOp::OpMultiply([a, a]));
+        let product = matrix(&mut graph, TensorOp::OpMultiply([a, b]));
+        let copy_a = matrix(&mut graph, TensorOp::OpCopy([a]));
+        let copy_b = matrix(&mut graph, TensorOp::OpCopy([b]));
+        graph.rebuild();
+        let patterns = [
+            (
+                "(multiply ?p0 ?p0__use1)",
+                Dtype::BF16,
+                vec![Some(64), Some(64)],
+            ),
+            ("(copy ?p0__use2)", Dtype::BF16, vec![Some(64), Some(64)]),
+        ];
+
+        let found = result_pairs(&graph, &patterns);
+        assert_eq!(
+            found,
+            HashSet::from([[graph.find(square), graph.find(copy_a)]])
+        );
+        assert!(!found.iter().any(|pair| pair[0] == graph.find(product)));
+        assert!(!found.contains(&[graph.find(square), graph.find(copy_b)]));
+    }
+
+    #[test]
+    fn shared_input_reshape_results_keep_metadata_and_shape_wildcards() {
+        // Both outputs reshape the same input, but have distinct metadata and
+        // result shapes. Binding the input in the first result must not turn
+        // the second reshape_? into an exact metadata lookup for literal '?'.
+        let mut graph = Graph::default();
+        let a = matrix(&mut graph, TensorOp::Var("a".into()));
+        let b = matrix(&mut graph, TensorOp::Var("b".into()));
+        let first = tensor(
+            &mut graph,
+            TensorOp::OpReshape("32,128".into(), [a]),
+            &[32, 128],
+        );
+        let second = tensor(
+            &mut graph,
+            TensorOp::OpReshape("16,256".into(), [a]),
+            &[16, 256],
+        );
+        let unrelated = tensor(
+            &mut graph,
+            TensorOp::OpReshape("16,256".into(), [b]),
+            &[16, 256],
+        );
+        graph.rebuild();
+        let patterns = [
+            ("(reshape_? ?p0)", Dtype::BF16, vec![Some(32), Some(128)]),
+            ("(reshape_? ?p0)", Dtype::BF16, vec![None, Some(256)]),
+        ];
+
+        let found = result_pairs(&graph, &patterns);
+        assert_eq!(
+            found,
+            HashSet::from([[graph.find(first), graph.find(second)]])
+        );
+        assert!(!found.contains(&[graph.find(first), graph.find(unrelated)]));
+    }
+}
