+/// Join typed matches using egg rather than enumerating their Cartesian product.
+/// Type filtering must precede the bounded join: rejected shapes must not consume
+/// the match budget. The temporary facts also keep ACT's metadata wildcards out
+/// of egg's exact-lookup optimization for already-bound pattern variables.
+fn joint_matches(
+    graph: &EGraph<TensorOp, TensorInfo>,
+    patterns: &[(&str, crate::ir::dtype::Dtype, Vec<Option<i32>>)],
+    limit: usize,
+) -> VecDeque<Vec<Match>> {
+    let mut facts = EGraph::<SymbolLang, ()>::default();
+    let mut rows = HashMap::new();
+    let mut clauses = vec![];
+    let mut binders = vec![];
+    for (slot, (text, dtype, shape)) in patterns.iter().enumerate() {
+        let pattern: Pattern<TensorOp> = text.parse().unwrap();
+        let vars = pattern.vars();
+        let canonical = |var: Var| var.to_string().split("__use").next().unwrap().to_owned();
+        let mut inputs: Vec<_> = vars.iter().map(|&var| canonical(var)).collect();
+        inputs.sort();
+        inputs.dedup();
+        let binder: Var = format!("?row_{slot}").parse().unwrap();
+        let arguments = inputs
+            .iter()
+            .map(|var| format!(" ?input_{}", &var[1..]))
+            .collect::<String>();
+        let query = format!("(slot_{slot} ?value_{slot}{arguments})");
+        clauses.push((binder, query.parse().unwrap()));
+        binders.push(binder);
+        let mut count = 0;
+        for matched in pattern.search(graph) {
+            if crate::ir::egraph::tuple_elements(graph, matched.eclass).is_some() {
+                continue;
+            }
+            let info = &graph[matched.eclass].data;
+            if info.dtype != *dtype
+                || info.shape.len() != shape.len()
+                || info
+                    .shape
+                    .iter()
+                    .zip(shape)
+                    .any(|(actual, required)| required.is_some_and(|required| *actual != required))
+            {
+                continue;
+            }
+            for subst in matched.substs {
+                let mut bindings = HashMap::new();
+                if !vars.iter().all(|&var| {
+                    let value = graph.find(subst[var]);
+                    bindings
+                        .insert(canonical(var), value)
+                        .is_none_or(|old| old == value)
+                }) {
+                    continue;
+                }
+                let id = graph.find(matched.eclass);
+                let operands: Vec<_> = inputs.iter().map(|var| bindings[var]).collect();
+                let children = std::iter::once(id)
+                    .chain(operands.iter().copied())
+                    .map(|value| facts.add(SymbolLang::leaf(format!("v{value}"))))
+                    .collect();
+                let row = facts.add(SymbolLang::new(format!("slot_{slot}"), children));
+                rows.insert(row, Match { id, operands });
+                count += 1;
+            }
+        }
+        if count == 0 {
+            return VecDeque::new();
+        }
+    }
+    if clauses.is_empty() || limit == 0 {
+        return VecDeque::new();
+    }
+    facts.rebuild();
+    MultiPattern::new(clauses)
+        .search_with_limit(&facts, limit)
+        .into_iter()
+        .flat_map(|matched| matched.substs)
+        .map(|subst| {
+            binders
                 .iter()
