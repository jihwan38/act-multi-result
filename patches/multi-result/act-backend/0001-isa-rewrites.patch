+use egg::{EGraph, Id, Pattern, Rewrite, SearchMatches, Searcher, Subst, Var};
+
+use crate::ir::egraph::{TensorInfo, TensorOp};
+
+/// GTE(Tuple(a0, ..., an), i) == ai, including tuple-valued elements.
+/// Union adds the direct value alternative; it does not erase the GTE edge
+/// through which a later tuple-producing instruction can still be selected.
+struct TupleProjection;
+
+impl Searcher<TensorOp, TensorInfo> for TupleProjection {
+    fn search_eclass_with_limit(
+        &self,
+        egraph: &EGraph<TensorOp, TensorInfo>,
+        eclass: Id,
+        limit: usize,
+    ) -> Option<SearchMatches<'_, TensorOp>> {
+        let mut substs = vec![];
+        for op in &egraph[eclass].nodes {
+            if let TensorOp::OpGetTupleElement(index, [tuple]) = op {
+                for candidate in &egraph[*tuple].nodes {
+                    if let TensorOp::OpTuple(children) = candidate {
+                        if let Some(&element) = children.get(*index) {
+                            if substs.len() < limit && egraph[eclass].data == egraph[element].data {
+                                let mut subst = Subst::default();
+                                subst.insert("?element".parse().unwrap(), element);
+                                substs.push(subst);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        (!substs.is_empty()).then_some(SearchMatches {
+            eclass,
+            substs,
+            ast: None,
+        })
+    }
+
+    fn vars(&self) -> Vec<Var> {
+        vec!["?element".parse().unwrap()]
+    }
+}
+
+pub fn projection_rule() -> Rewrite<TensorOp, TensorInfo> {
+    Rewrite::new(
+        "tuple-projection",
+        TupleProjection,
+        "?element".parse::<Pattern<TensorOp>>().unwrap(),
+    )
+    .unwrap()
+}
