@@ -0,0 +1,160 @@
+"""One semantic DAG lowering for scalar and ordered multi-result instructions."""
+import ast
+from dataclasses import dataclass
+import re
+from taidl.semantics import semantic_interface, tensor_type
+
+OP_MAP = {
+    "reshape": "reshape_?", "convert": "convert_?", "slice": "slice_?",
+    "transpose": "transpose_?", "broadcast": "broadcast_?",
+    "concatenate": "concat_?", "concat": "concat_?", "constant": "constant_?",
+    "eye": "eye_?", "bitcast_convert": "bitcvt", "reduce_add": "reduce_?",
+    "shift_left": "shift-left", "shift_right_logical": "shift-right-logical",
+}
+
+
+def dimension(text):
+    """Return (attribute, coefficient, constant) for an affine dimension.
+
+    Infer an attribute from any matching tensor, then validate every occurrence.
+    Nonlinear/ambiguous expressions fail generation instead of guessing values.
+    """
+    tree = ast.parse(re.sub(r"@c\.(\w+)", r"\1", text.replace("`", "")), mode="eval").body
+    def read(node):
+        if isinstance(node, ast.Constant) and type(node.value) is int:
+            return None, 0, node.value
+        if isinstance(node, ast.Name):
+            return node.id, 1, 0
+        if isinstance(node, ast.BinOp):
+            a, x, c = read(node.left)
+            b, y, d = read(node.right)
+            if isinstance(node.op, ast.Mult) and (a is None or b is None):
+                return (b, c * y, c * d) if a is None else (a, d * x, d * c)
+            if isinstance(node.op, (ast.Add, ast.Sub)) and (a is None or b is None or a == b):
+                sign = -1 if isinstance(node.op, ast.Sub) else 1
+                return a or b, x + sign * y, c + sign * d
+        raise ValueError(f"Unsupported dimension expression: {text}")
+    attr, factor, offset = read(tree)
+    if (attr and factor == 0) or (not attr and offset < 0):
+        raise ValueError(f"Invalid dimension expression: {text}")
+    return attr, factor, offset
+
+
+@dataclass
+class Node:
+    token: str
+    children: list
+    dtype: str
+    shape: list
+    operation: str
+    attrs: dict
+
+
+@dataclass
+class Semantics:
+    pattern: str
+    parameters: list
+    postorder: list
+    parts: list
+    results: list
+    attributes: list
+    match_pattern: str
+    match_parts: list
+
+
+def lower_semantics(metadata):
+    interface = semantic_interface(metadata.semantics_ast, input_count=metadata.rhs_size - 1)
+    declarations, parameters = {}, {}
+    multiple = len(interface.results) > 1
+    for ctx in metadata.semantics_ast.instruction():
+        # The ROOT tuple declares result order; its tensor operands are already
+        # nodes in this DAG. It is not a tensor computation with a fake shape.
+        if ctx.OPERATION().getText() == "tuple":
+            continue
+        name = ctx.IDENTIFIER().getText()
+        if name in declarations:
+            raise ValueError(f"Repeated semantics symbol: {name}")
+        dtype, declared_shape = tensor_type(ctx.result_type())
+        dimensions = list(declared_shape)
+        for part in dimensions:
+            dimension(part)
+        op = ctx.OPERATION().getText()
+        operands = [o.value().getText() for o in ctx.operands().operand()] if ctx.operands() else []
+        attrs = {}
+        if ctx.attributes():
+            for item in ctx.attributes().attribute():
+                key = item.IDENTIFIER().getText()
+                if key in attrs:
+                    raise ValueError(f"Repeated semantics attribute: {key}")
+                attrs[key] = item.attributeValue().getText()
+        if op == "parameter":
+            if len(operands) != 1 or not operands[0].isdigit():
+                raise ValueError("Invalid semantics parameter")
+            index = int(operands[0])
+            if index in parameters:
+                raise ValueError("Repeated semantics parameter number")
+            token = parameters[index] = (f"?p{index}" if multiple or index >= 26
+                                         else "?" + chr(ord("a") + index))
+            children = []
+        else:
+            arities = {"add": 2, "bitcast_convert": 1, "broadcast": 1,
+                       "concatenate": 2, "concat": 2, "convert": 1, "copy": 1,
+                       "divide": 2, "dot": 2, "exponential": 1, "multiply": 2,
+                       "or": 2, "reduce_add": 1, "reshape": 1,
+                       "shift_left": 2, "shift_right_logical": 2,
+                       "transpose": 1, "xor": 2}
+            if op not in arities or len(operands) != arities[op]:
+                raise ValueError(f"Unsupported TensorOp operation/arity: {op}/{len(operands)}")
+            if op in ("broadcast", "transpose", "concatenate", "concat", "reduce_add") and "dimensions" not in attrs:
+                raise ValueError(f"{op} requires dimensions")
+            children = []
+            for operand in operands:
+                if operand not in declarations:
+                    raise ValueError(f"Undefined semantics operand: {operand}")
+                children.append(declarations[operand])
+            token = OP_MAP.get(op, op)
+        if op == "dot":
+            if attrs != {"lhs_contracting_dims": "{1}", "rhs_contracting_dims": "{0}"}:
+                raise ValueError("dot requires the standard matrix product represented by OpDot")
+        elif attrs and not (op in ("broadcast", "transpose", "concatenate", "concat", "reduce_add")
+                            and set(attrs) == {"dimensions"}):
+            raise ValueError(f"Unsupported semantics attributes on {op}: {attrs}")
+        node = Node(token, children, dtype, dimensions, op, attrs)
+        declarations[name] = node
+    if sorted(parameters) != list(range(metadata.rhs_size - 1)):
+        raise ValueError("Semantics parameters must match the declared ISA inputs")
+    ordered = [declarations[result.IDENTIFIER().getText()] for result in interface.results]
+    postorder, used = [], set()
+    def pattern(node):
+        parts = [pattern(child) for child in node.children]
+        postorder.append(node)
+        if node.token.startswith("?"):
+            used.add(node.token)
+            return node.token
+        return "(" + node.token + (" " if parts else "") + " ".join(parts) + ")"
+    parts = [pattern(node) for node in ordered]
+    if used != set(parameters.values()):
+        raise ValueError("Every declared ISA input must contribute to an output")
+    inferred = sorted({dimension(d)[0] for node in postorder for d in node.shape if dimension(d)[0]})
+    attributes = list(getattr(metadata, "comp_attrs", None) or inferred)
+    if metadata.has_comp_attrs and not attributes:
+        raise ValueError("Computation attributes must be inferable from tensor dimensions")
+    if set(attributes) != set(inferred):
+        raise ValueError("Declared computation attributes must match inferable shape attributes")
+    lhs = parts[0] if len(parts) == 1 else "(tuple " + " ".join(parts) + ")"
+    # Egg uses exact lookup when every variable below an operator is already
+    # bound. That shortcut cannot look up ACT's metadata-wildcard operators
+    # (broadcast_?, reshape_?, ...). Fresh occurrence variables avoid it;
+    # preconditions below enforce the original shared-value equalities.
+    occurrences = {}
+    def matcher(node):
+        if node.token.startswith("?"):
+            count = occurrences.get(node.token, 0)
+            occurrences[node.token] = count + 1
+            return node.token if count == 0 else f"{node.token}__use{count}"
+        children = [matcher(child) for child in node.children]
+        return "(" + node.token + (" " if children else "") + " ".join(children) + ")"
+    match_parts = [matcher(node) for node in ordered]
+    match_pattern = match_parts[0] if len(parts) == 1 else "(tuple " + " ".join(match_parts) + ")"
+    return Semantics(lhs, [parameters[i] for i in sorted(parameters)], postorder, parts,
+                     ordered, attributes, match_pattern, match_parts)
