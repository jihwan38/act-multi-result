 // E-class metadata
+/// Tuple structure is derived from ordered children (possibly other tuples), not the
+/// legacy tensor-only analysis slot on the aggregate e-class. Rewriting retains
+/// the OpTuple alternative even when a tuple-producing ISA candidate is added.
+pub fn tuple_elements(
+    egraph: &EGraph<TensorOp, TensorInfo>,
+    id: Id,
+) -> Option<Vec<Id>> {
+    fn resolve(
+        graph: &EGraph<TensorOp, TensorInfo>, id: Id, path: &mut std::collections::HashSet<Id>,
+    ) -> Option<Vec<Id>> {
+        let id = graph.find(id);
+        if !path.insert(id) { return None; }
+        let direct = graph[id].nodes.iter().find_map(|en| match en {
+            TensorOp::OpTuple(children) => Some(children.iter().map(|&id| graph.find(id)).collect()),
+            _ => None,
+        });
+        let result = direct.or_else(|| graph[id].nodes.iter().find_map(|en| {
+            if let TensorOp::OpGetTupleElement(index, [source]) = en {
+                let elements = resolve(graph, *source, path)?;
+                return resolve(graph, *elements.get(*index)?, path);
+            }
+            None
+        }));
+        path.remove(&id);
+        result
+    }
+    resolve(egraph, id, &mut std::collections::HashSet::new())
+}
