diff --git a/act_backend/generic/src/isel/rewrites/joint.rs b/act_backend/generic/src/isel/rewrites/joint.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0ee3d677fe679dd961488e4f0f8ff0b7e7d0af97
--- /dev/null
+++ b/act_backend/generic/src/isel/rewrites/joint.rs
@@ -0,0 +1,120 @@
+//! Operand feasibility for a particular multi-result semantic match.
+//! A tuple is only a value aggregate; it is never proof that a match is eligible.
+use std::collections::{HashMap, HashSet};
+use std::time::Instant;
+
+use crate::ir::egraph::{tuple_elements, TensorInfo, TensorOp};
+use egg::{EGraph, Id, Language};
+
+/// The external pattern operands of one result, not all nodes inside its body.
+/// An ISA may implement dependencies internally, e.g. outputs f(a), g(f(a)).
+pub(crate) struct ResultMatch {
+    pub value: Id,
+    pub operands: Vec<Id>,
+}
+
+/// An e-class is an OR of implementations; one implementation needs ALL inputs.
+/// Discovery can reuse this snapshot until the next refresh. ISA preconditions
+/// construct a fresh snapshot so another match/rewrite cannot inherit a verdict.
+#[derive(Default)]
+pub(crate) struct Derivations {
+    alternatives: Vec<(Id, Vec<Id>)>,
+    independent: HashMap<Vec<Id>, HashSet<Id>>,
+}
+
+impl Derivations {
+    pub(crate) fn new(graph: &EGraph<TensorOp, TensorInfo>) -> Self {
+        let mut alternatives = vec![];
+        for class in graph.classes() {
+            for op in &class.nodes {
+                let children = if let TensorOp::OpGetTupleElement(index, [tuple]) = op {
+                    // A projection needs its selected element, not its siblings.
+                    let Some(elements) = tuple_elements(graph, *tuple) else {
+                        continue;
+                    };
+                    let Some(&element) = elements.get(*index) else {
+                        continue;
+                    };
+                    vec![element]
+                } else {
+                    op.children().to_vec()
+                };
+                alternatives.push((
+                    class.id,
+                    children.into_iter().map(|id| graph.find(id)).collect(),
+                ));
+            }
+        }
+        Self {
+            alternatives,
+            independent: HashMap::new(),
+        }
+    }
+
+    fn without(&mut self, blocked: Vec<Id>, deadline: Option<Instant>) -> Option<&HashSet<Id>> {
+        if !self.independent.contains_key(&blocked) {
+            let forbidden: HashSet<_> = blocked.iter().copied().collect();
+            let mut available = HashSet::new();
+            // Least fixed point: only finite derivations from leaves qualify.
+            // Copy/projection cycles cannot establish availability by themselves.
+            loop {
+                if deadline.is_some_and(|end| Instant::now() >= end) {
+                    return None;
+                }
+                let before = available.len();
+                for (id, children) in &self.alternatives {
+                    // An equivalent input/constant needs no result execution.
+                    if (children.is_empty() || !forbidden.contains(id))
+                        && children.iter().all(|c| available.contains(c))
+                    {
+                        available.insert(*id);
+                    }
+                }
+                if available.len() == before {
+                    break;
+                }
+            }
+            self.independent.insert(blocked.clone(), available);
+        }
+        self.independent.get(&blocked)
+    }
+
+    pub(crate) fn inputs_available(
+        &mut self,
+        results: &[ResultMatch],
+        deadline: Option<Instant>,
+    ) -> bool {
+        for result in results {
+            let mut blocked: Vec<_> = results
+                .iter()
+                .map(|other| other.value)
+                .filter(|&id| id != result.value)
+                .collect();
+            blocked.sort_unstable();
+            blocked.dedup();
+            let Some(available) = self.without(blocked, deadline) else {
+                return false;
+            };
+            if result.operands.iter().any(|id| !available.contains(id)) {
+                return false;
+            }
+        }
+        true
+    }
+}
+
+/// Authoritative ISA gate, independent of how the tuple entered the e-graph.
+/// No persistent pass/fail cache: unions can change eligibility between calls.
+pub(crate) fn inputs_available(
+    graph: &EGraph<TensorOp, TensorInfo>,
+    results: &[ResultMatch],
+) -> bool {
+    let results: Vec<_> = results
+        .iter()
+        .map(|result| ResultMatch {
+            value: graph.find(result.value),
+            operands: result.operands.iter().map(|&id| graph.find(id)).collect(),
+        })
+        .collect();
+    Derivations::new(graph).inputs_available(&results, None)
+}
