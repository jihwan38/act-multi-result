@@ -0,0 +1,75 @@
+//! Logical tuple structure is independent of the flat physical tensor ABI.
+use crate::ir::dtype::Dtype;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct TensorType {
+    pub dtype: Dtype,
+    pub shape: Vec<i32>,
+    pub tile: String,
+}
+
+impl TensorType {
+    pub fn shape_text(&self) -> String {
+        self.shape
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join(",")
+    }
+
+    pub fn bytes(&self) -> i32 {
+        self.shape
+            .iter()
+            .try_fold(self.dtype.size_in_bytes(), |bytes, &dim| {
+                assert!(dim >= 0, "Negative tensor dimension");
+                bytes.checked_mul(dim)
+            })
+            .expect("Tensor byte size exceeds ACT address range")
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum ValueType {
+    Tensor(TensorType),
+    Tuple(Vec<ValueType>),
+}
+
+/// Leaf indices are in depth-first ABI order; [] denotes a genuine empty tuple.
+#[derive(Debug, Clone, PartialEq, serde::Serialize)]
+#[serde(untagged)]
+pub enum ValueTree {
+    Leaf(usize),
+    Tuple(Vec<ValueTree>),
+}
+
+impl ValueType {
+    pub fn leaves(&self) -> Vec<&TensorType> {
+        match self {
+            Self::Tensor(tensor) => vec![tensor],
+            Self::Tuple(elements) => elements.iter().flat_map(Self::leaves).collect(),
+        }
+    }
+
+    pub fn tree(&self, next: &mut usize) -> ValueTree {
+        match self {
+            Self::Tensor(_) => {
+                let index = *next;
+                *next += 1;
+                ValueTree::Leaf(index)
+            }
+            Self::Tuple(elements) => {
+                ValueTree::Tuple(elements.iter().map(|ty| ty.tree(next)).collect())
+            }
+        }
+    }
+
+    pub fn same_type(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Self::Tensor(a), Self::Tensor(b)) => a.dtype == b.dtype && a.shape == b.shape,
+            (Self::Tuple(a), Self::Tuple(b)) => {
+                a.len() == b.len() && a.iter().zip(b).all(|(a, b)| a.same_type(b))
+            }
+            _ => false,
+        }
+    }
+}
