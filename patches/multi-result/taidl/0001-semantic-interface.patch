@@ -0,0 +1,85 @@
+"""The tensor inputs and ordered physical results of one ISA instruction.
+
+A semantics body has exactly one ROOT. A tensor ROOT returns one result; a
+flat tuple ROOT returns two or more results in operand order. Tuple construction
+declares the output interface and does not assert independent/parallel execution.
+Backend and Oracle share this interpretation instead of interpreting output names.
+"""
+from dataclasses import dataclass
+import re
+
+
+@dataclass(frozen=True)
+class SemanticInterface:
+    inputs: tuple
+    results: tuple
+
+
+def tensor_type(context):
+    """A canonical declared tensor type; no generator-specific shape inference."""
+    if context.TYPE() is None:
+        raise ValueError("ISA results must be tensors; nested tuple returns are unsupported")
+    shape = context.shape().getText() if context.shape() else ""
+    dimensions = tuple(re.sub(r"\s+", "", value.replace("`", ""))
+                       for value in shape.split(",") if value.strip())
+    return context.TYPE().getText(), dimensions
+
+
+def semantic_interface(module, input_count=None, output_count=None):
+    """Validate bindings and resolve return operands in physical port order.
+
+    Names are local symbols, not input/output port numbers. Parameter indices
+    define input order; the ROOT tuple's operand list defines output order.
+    A ROOT may precede unrelated declarations, but tuple operands must already
+    be defined. Instructions without semantics should not call this function.
+    """
+    instructions = list(module.instruction())
+    roots = [node for node in instructions if node.ROOT() is not None]
+    if len(roots) != 1:
+        raise ValueError("Semantics requires exactly one ROOT; return multiple results with ROOT ... tuple(...)")
+    root = roots[0]
+    declarations, parameters = {}, {}
+    results = None
+    for node in instructions:
+        name = node.IDENTIFIER().getText()
+        if name in declarations:
+            raise ValueError(f"Repeated semantics symbol: {name}")
+        op = node.OPERATION().getText()
+        operands = [value.value().getText() for value in node.operands().operand()] if node.operands() else []
+        if op == "tuple":
+            if node is not root or node.attributes() is not None:
+                raise ValueError("Only the ROOT may construct the ISA result tuple, without attributes")
+            if node.result_type().TYPE() is not None:
+                raise ValueError("A tuple return requires a tuple result type")
+            types = node.result_type().result_type()
+            if len(operands) < 2 or len(types) != len(operands):
+                raise ValueError("A tuple return requires at least two tensor results and matching type arity")
+            values = []
+            for index, (operand, declared_type) in enumerate(zip(operands, types)):
+                if operand not in declarations:
+                    raise ValueError(f"Undefined tuple return operand: {operand}")
+                value = declarations[operand]
+                if tensor_type(declared_type) != tensor_type(value.result_type()):
+                    raise ValueError(f"Tuple result {index} type does not match {operand}")
+                values.append(value)
+            results = tuple(values)
+        else:
+            tensor_type(node.result_type())
+            if op == "parameter":
+                if len(operands) != 1 or not operands[0].isdigit():
+                    raise ValueError("Invalid semantics parameter")
+                index = int(operands[0])
+                if index in parameters:
+                    raise ValueError("Repeated semantics parameter number")
+                parameters[index] = node
+            if node is root:
+                results = (node,)
+        declarations[name] = node
+    if sorted(parameters) != list(range(len(parameters))):
+        raise ValueError("Semantics parameter indices must be contiguous from zero")
+    inputs = tuple(parameters[index] for index in range(len(parameters)))
+    if input_count is not None and len(inputs) != input_count:
+        raise ValueError("Semantics parameter/input count mismatch")
+    if output_count is not None and len(results) != output_count:
+        raise ValueError("Semantics result/output count mismatch")
+    return SemanticInterface(inputs, results)
